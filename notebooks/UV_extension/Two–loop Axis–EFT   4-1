{"cells":[{"cell_type":"markdown","metadata":{"id":"4FomLPN-lvR0"},"source":["Sec 3.2 figure 1\n"]},{"cell_type":"code","source":["# -- uncluttered layout for Fig. 3A --\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from matplotlib.offsetbox import AnchoredText\n","import matplotlib.ticker as mtick\n","\n","m0_sq, lam_Sigma, tau2 = (200.0)**2, 0.25, 1.0e3\n","eta0, eta2_list = 1.0e6, [5.0e5, 2.0e5]\n","v, volB = 1.0e3, 1.0\n","f, theta_star = 0.5, 0.0\n","\n","rho_max = 3.0e3\n","rho = np.linspace(0.0, rho_max, 1200)\n","\n","def eta_of(r, eta2): return eta0 + eta2*r**2\n","def tau_of(r):       return tau2*r**2\n","\n","def V_eff(r, eta2, Lq):\n","    return (0.5*m0_sq*r**2 + 0.25*lam_Sigma*r**4\n","            + 0.5*tau_of(r)*(6.0*v**2)\n","            + 0.5*(Lq**2/eta_of(r, eta2))*volB)\n","\n","def m_eff_sq(Lq, eta2):\n","    return m0_sq + 6.0*(v**2)*tau2 - eta2*(Lq**2/eta0**2)*volB\n","\n","def Lcrit(eta2):\n","    return eta0*np.sqrt((m0_sq + 6.0*(v**2)*tau2)/(eta2*volB))\n","\n","def find_min(r, V):\n","    i = np.argmin(V)\n","    return r[i], V[i]\n","\n","ig, axes = plt.subplots(1, 2, figsize=(11.6, 4.6), sharey=True)\n","\n","all_labels = [r'$\\Lambda_q = 0.8\\,\\Lambda_q^{\\mathrm{crit}}$',\n","              r'$\\Lambda_q = \\Lambda_q^{\\mathrm{crit}}$',\n","              r'$\\Lambda_q = 1.2\\,\\Lambda_q^{\\mathrm{crit}}$']\n","\n","for ax, eta2 in zip(axes, eta2_list):\n","    Lc = Lambda_q_crit(eta2)\n","    sweep = [0.8*Lc, 1.0*Lc, 1.2*Lc]\n","    lines = []\n","\n","    # curves\n","    for Lq, lab in zip(sweep, all_labels):\n","        V = V_eff(rho, eta2, Lq)\n","        ln, = ax.plot(rho, V, lw=1.8, label=lab)\n","        lines.append(ln)\n","\n","        meff2 = m_eff_sq(Lq, eta2)\n","        if meff2 < 0.0:\n","            r0, V0 = find_min(rho, V)\n","            ax.plot([r0], [V0], marker='*', ms=8, zorder=5)\n","            ax.annotate(rf'$\\rho_0 \\approx {r0:.0f}$', xy=(r0, V0),\n","                        xytext=(r0 + 0.10*rho_max, V0 + 0.06*(ax.get_ylim()[1]-ax.get_ylim()[0])),\n","                        arrowprops=dict(arrowstyle='->', lw=0.9), fontsize=9)\n","\n","    # compact curvature summary (upper-left)\n","    meff_lines = \"\\n\".join(\n","        rf\"$m_{{\\mathrm{{eff}}}}^2(0)={m_eff_sq(Lq, eta2):.2e}$\" for Lq in sweep\n","    )\n","    at = AnchoredText(meff_lines, loc='upper left', prop=dict(size=9),\n","                      frameon=True, pad=0.3, borderpad=0.6)\n","    at.patch.set_alpha(0.85)\n","    ax.add_artist(at)\n","\n","    # move \"crit: ...\" out of the title, into bottom-right inside the axes\n","    ax.text(0.98, 0.04, rf'$\\Lambda_q^{{\\mathrm{{crit}}}}={Lc:.2e}$',\n","            transform=ax.transAxes, ha='right', va='bottom', fontsize=9)\n","\n","    # minimal title & spacing\n","    ax.set_title(rf'$\\eta_2 = {eta2:.1e}$', pad=6, fontsize=11)\n","\n","    ax.set_xlim(0, rho_max)\n","    ax.margins(y=0.05)\n","    ax.grid(alpha=0.12, linestyle='--')\n","    ax.set_xlabel(r'$\\rho$')\n","\n","axes[0].set_ylabel(r'$V_{\\mathrm{eff}}(\\rho)$')\n","\n","# single-line, higher suptitle\n","fig.suptitle(r'Fig. 3A — $V_{\\mathrm{eff}}(\\rho)$ across $\\Lambda_q$ '\n","             r'(two $\\eta_2$; flip at $m_{\\mathrm{eff}}^{2}(0)=0$)',\n","             y=0.98, fontsize=12)\n","\n","# figure-level legend **below** the axes (keeps top empty)\n","handles, labels = axes[0].get_legend_handles_labels()\n","fig.legend(handles, all_labels, loc='lower center', bbox_to_anchor=(0.5, 0.02),\n","           ncol=3, frameon=False, fontsize=9)\n","\n","# caption a bit lower to avoid the legend\n","caption = (\n","    r'Parameters: $m_0^2=%.1e$, $\\lambda_\\Sigma=%.2f$, $\\tau_2=%.1e$, '\n","    r'$\\eta_0=%.1e$, $v=%.1e$, $\\mathrm{vol}_B=%.1f$, $f=%.2f$, $\\theta_\\star=%.2f$. '\n","    r'Each panel uses $\\Lambda_q\\!\\in\\!\\{0.8,1.0,1.2\\}\\Lambda_q^{\\mathrm{crit}}$ with '\n","    r'$\\Lambda_q^{\\mathrm{crit}}\\!=\\!\\eta_0\\sqrt{(m_0^2+6v^2\\tau_2)/(\\eta_2\\,\\mathrm{vol}_B)}$.'\n","    % (m0_sq, lam_Sigma, tau2, eta0, v, volB, f, theta_star)\n",")\n","fig.text(0.5, -0.06, caption, ha='center', va='top', fontsize=9)\n","\n","# generous top/bottom room so nothing collides\n","fig.tight_layout(rect=(0.03, 0.10, 0.97, 0.90))\n","fig.savefig(\"fig3A_Veff_phase_diagram.png\", dpi=600, bbox_inches=\"tight\", pad_inches=0.02)\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":457},"id":"OQMMkORzvsGg","executionInfo":{"status":"ok","timestamp":1759841991759,"user_tz":240,"elapsed":2883,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"1a97db28-3666-47e5-c66f-f3ac83e43703"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1160x460 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"_XGs7ha8l0N-"},"source":["Sec 3 figure 2"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":483},"executionInfo":{"elapsed":1715,"status":"ok","timestamp":1759836290800,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"},"user_tz":240},"id":"kmUr26k16ALP","outputId":"f43c15d9-ee03-4b40-a809-cc77223b7472"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1350x580 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Fig. 3B — SU(2) -> U(1)_n schematic (final tweak)\n","import matplotlib.pyplot as plt\n","from matplotlib.patches import FancyBboxPatch, FancyArrowPatch\n","\n","def box(ax, xy, w, h, text, fontsize=12, fc='white', ec='black', lw=1.2, align='center'):\n","    x, y = xy\n","    patch = FancyBboxPatch((x, y), w, h, boxstyle=\"round,pad=0.24,rounding_size=0.10\",\n","                           fc=fc, ec=ec, lw=lw)\n","    ax.add_patch(patch)\n","    ha = {'center':'center','left':'left'}[align]\n","    ax.text(x + (w/2 if align=='center' else 0.18), y + h/2, text, ha=ha, va='center', fontsize=fontsize)\n","    return patch, (x, y, w, h)\n","\n","def arrow(ax, p, q, lw=1.3, rad=0.0):\n","    ax.add_patch(FancyArrowPatch(p, q, arrowstyle='-|>', mutation_scale=13,\n","                                 lw=lw, color='black',\n","                                 connectionstyle=f'arc3,rad={rad}'))\n","\n","fig, ax = plt.subplots(figsize=(13.5, 5.8))\n","ax.set_axis_off()\n","ax.set_xlim(0, 16)\n","ax.set_ylim(0, 7)\n","\n","# --- Top row\n","(_, (xsu, ysu, wsu, hsu)) = box(ax, (1.4, 4.8), 3.0, 1.1, r'$G=\\mathrm{SU}(2)$')\n","ax.text(8.0, 6.15, r'$\\Rightarrow\\ \\rho=\\rho_0,\\ \\text{simplicity }(B_0=v\\Sigma)$',\n","        fontsize=12, ha='center', va='center')\n","(u1, (xu, yu, wu, hu)) = box(ax, (10.5, 4.8), 3.0, 1.1, r'$\\mathrm{U}(1)_n$')\n","ax.text(xu+wu/2, yu-0.25, r'(Cartan along $n^i(\\Sigma)$)', ha='center', va='top', fontsize=10)\n","arrow(ax, (xsu+wsu+0.8, ysu+hsu/2), (xu-0.5, yu+hu/2))\n","\n","# --- Bottom row\n","(_, (xa, ya, wa, ha_)) = box(ax, (1.4, 1.6), 5.8, 1.45,\n","           r'Gauge field $A^i$'+'\\n'+r'$A=A_{\\parallel}+A_{\\perp},\\quad A_{\\parallel}\\equiv(A\\!\\cdot\\! n)\\,n$',\n","           fontsize=11, align='left')\n","arrow(ax, (xsu+wsu/2, ysu), (xa+0.7, ya+ha_+0.05))\n","\n","(zbox, (xz, yz, wz, hz)) = box(ax, (8.6, 1.6), 4.4, 1.45,\n","           r'Axis projection in coherent domain'+'\\n'+r'$Z \\equiv A^i n_i$',\n","           fontsize=11, align='left')\n","arrow(ax, (xu+wu/2, yu), (xz+wz/2, yz+hz+0.05))\n","arrow(ax, (xa+wa, ya+hz/2), (xz-0.1, yz+hz/2), rad=0.25)\n","\n","# --- Call-out (right of Z box, vertically centered)\n","(call, (xc, yc, wc, hc)) = box(ax, (13.3, yz+hz/2-0.95), 2.2, 1.9,\n","              r'$\\frac{1}{g_Z^{2}}=\\frac{\\omega_{\\mathrm{proj}}}{g_{\\mathrm{NA}}^{2}}$'\n","              '\\n'\n","              r'$\\omega_{\\mathrm{proj}}=1$ on $B_0=v\\Sigma$'\n","              '\\n'\n","              r'$\\mathrm{Tr}(T^iT^j)=\\delta^{ij}$ fixed',\n","              fontsize=10, fc='0.96')\n","# connector from right edge of Z box to left edge of call-out\n","arrow(ax, (xz+wz, yz+hz/2), (xc, yc+hc/2))\n","\n","plt.savefig(\"fig3B_su2_to_u1_projector.png\", dpi=600, bbox_inches=\"tight\", pad_inches=0.03)\n","plt.show()\n","\n","\n","\n"]},{"cell_type":"markdown","metadata":{"id":"IfRBWC1gl3UV"},"source":["Sec 3 figure 3"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":466},"executionInfo":{"elapsed":1799,"status":"ok","timestamp":1759836296724,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"},"user_tz":240},"id":"cFzpJR3jlmhY","outputId":"1c6f5976-6582-4a09-8f41-81708c47cdd7"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 680x460 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["#@title Fig.One-loop g_Z(μ): naive vs matched (U(1) terminates at Λ_q)\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# --- illustrative parameters (signs/structure match the paper) ---\n","bZ       = 5.0       # >0 for Abelian U(1)Z (one-loop)\n","mu_min   = 1.0e2\n","mu_max   = 1.0e8\n","Lambda_q = 1.0e5\n","\n","mu0 = 1.0e3\n","g0  = 0.35           # naive U(1) initial value at μ0 (for illustration)\n","\n","# Naive U(1) evolution (incorrect above Λ_q; shows pole if extrapolated)\n","mu_no = np.logspace(np.log10(mu_min), np.log10(mu_max), 1000)\n","inv_g2_no = 1.0/g0**2 - (bZ/(8*np.pi**2))*np.log(mu_no/mu0)\n","with np.errstate(divide='ignore', invalid='ignore'):\n","    g_no = 1.0/np.sqrt(inv_g2_no)\n","landau_mask = inv_g2_no > 0\n","# Landau pole scale (where inv_g2_no = 0): μ_pole = μ0 * exp(8π^2/(bZ g0^2))\n","mu_pole = mu0 * np.exp(8*np.pi**2/(bZ*g0**2))\n","\n","# Matched curve: initial condition from non-Abelian parent at Λ_q\n","omega_proj = 1.0\n","g_NA_Lq    = 0.60    # from App. B: g_NA^(-2)=1/τ(ρ0)\n","inv_g2_match_Lq = omega_proj / (g_NA_Lq**2)\n","\n","mu_match = np.logspace(np.log10(mu_min), np.log10(Lambda_q), 800)  # U(1) valid only below Λ_q\n","inv_g2_match = inv_g2_match_Lq - (bZ/(8*np.pi**2))*np.log(mu_match/Lambda_q)\n","g_match = 1.0/np.sqrt(inv_g2_match)\n","\n","# --- plot ---\n","fig, ax = plt.subplots(figsize=(6.8, 4.6))\n","\n","# Shade \"no Abelian above Λ_q\"\n","ax.axvspan(Lambda_q, mu_max, color='0.9', alpha=0.6, label=r'no $U(1)$ above $\\Lambda_q$')\n","\n","# Naive extrapolation (for comparison only)\n","ax.plot(mu_no[landau_mask], g_no[landau_mask], lw=2.0, label='Naive U(1) (no matching)')\n","\n","# Matched U(1) below Λ_q\n","ax.plot(mu_match, g_match, lw=2.0, linestyle='--',\n","        label=r'Matched at $\\Lambda_q$ (valid only for $\\mu<\\Lambda_q$)')\n","\n","# Λ_q marker\n","ax.axvline(Lambda_q, linestyle=':', lw=1.6, label=r'$\\Lambda_q$ (matching)')\n","\n","# Landau pole marker (for naive-only visualization)\n","if mu_min < mu_pole < mu_max:\n","    ax.axvline(mu_pole, color='tab:red', lw=1.2, linestyle='-.', alpha=0.8)\n","    ax.text(mu_pole, ax.get_ylim()[1]*0.98, r'Landau pole (naive)', rotation=90,\n","            ha='right', va='top', fontsize=9)\n","\n","# Matching condition annotation\n","ax.text(Lambda_q*1.15, np.interp(Lambda_q*1.15, mu_no[landau_mask], g_no[landau_mask]),\n","        r'$\\frac{1}{g_Z^2(\\Lambda_q^-)}=\\frac{\\omega_{\\mathrm{proj}}}{g_{\\mathrm{NA}}^2(\\Lambda_q^+)}$'+'\\n'+\n","        r'$\\omega_{\\mathrm{proj}}=1$',\n","        fontsize=9)\n","\n","ax.set_xscale('log')\n","ax.set_xlabel(r'$\\mu$')\n","ax.set_ylabel(r'$g_Z(\\mu)$')\n","#  ax.set_title(r'One-loop $g_Z(\\mu)$: naive vs matched (no Abelian above $\\Lambda_q$)')\n","ax.legend(loc='best', fontsize=9)\n","fig.tight_layout()\n","\n","# Save print-ready\n","fig.savefig(\"fig3C_gZ_naive_vs_matched.png\", dpi=600, bbox_inches=\"tight\", pad_inches=0.02)\n","plt.show()\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":45,"status":"ok","timestamp":1759836329998,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"},"user_tz":240},"id":"C7l5h0Z0v9h6","outputId":"fa540038-48cd-443b-c677-f5f570c20f7f"},"outputs":[{"name":"stdout","output_type":"stream","text":["Table 1 (roster): [('phi', 'scalar', 1, 0.0, 0.0, 1.0), ('e', 'Dirac', 1, 1.0, 1.0, 0.0), ('mu', 'Dirac', 1, 1.0, 1.0, 0.0), ('tau', 'Dirac', 1, 1.0, 1.0, 0.0), ('u', 'Dirac', 3, 1.0, 1.0, 0.0), ('d', 'Dirac', 3, 1.0, 1.0, 0.0), ('s', 'Dirac', 3, 1.0, 1.0, 0.0), ('c', 'Dirac', 3, 1.0, 1.0, 0.0), ('b', 'Dirac', 3, 1.0, 1.0, 0.0), ('t', 'Dirac', 3, 1.0, 1.0, 0.0)]\n","Table 2 (totals): {'S2F': 42.0, 'S2S': 1.0, 'S4F': 42.0, 'S4S': 1.0, 'Y2': 2.9558616583845305, 'Y4': 2.908445106292954, 'Y2(Q^2)': 8.86758497515359}\n","Two-loop coeffs: {'b1': 56.333333333333336, 'b2': 169.0, 'cY': 2.0}\n"]}],"source":["#@title Reproduces Appendix E tables for the worked example\n","# \"A Pre-Geometric Ultraviolet Completion of the Axis Model\"\n","\n","from dataclasses import dataclass\n","from typing import List, Dict, Tuple\n","import math\n","import json\n","import csv\n","\n","V_HIGGS_GEV = 246.22  # v, per App. E (mu_EW)\n","TRACE_NORMALIZATION_HALF = False  # if True, use Tr(T_i T_j) = (1/2) delta_ij -> halves b2 only\n","\n","@dataclass\n","class Species:\n","    name: str\n","    kind: str       # 'Dirac' or 'scalar'\n","    N: int          # multiplicity (colors, families)\n","    QL: float       # left charge (Dirac only)\n","    QR: float       # right charge (Dirac only)\n","    Qphi: float     # scalar charge (scalar only; ignored for fermions)\n","    mass_GeV: float # pole mass used for Yukawa (Dirac only); 0 for scalar\n","\n","def yukawa_from_mass(mass_GeV: float, v=V_HIGGS_GEV) -> float:\n","    return math.sqrt(2.0)*mass_GeV/v\n","\n","def make_roster_E5() -> List[Species]:\n","    # Table 1 roster (App. E.5): QL=QR=1 for all Dirac; Qphi=1 for scalar phi\n","    r = []\n","    r.append(Species(\"phi\", \"scalar\", 1, 0.0, 0.0, 1.0, 0.0))\n","    # Leptons (N=1)\n","    r += [\n","        Species(\"e\",   \"Dirac\", 1, 1.0, 1.0, 0.0, 0.00051099895),\n","        Species(\"mu\",  \"Dirac\", 1, 1.0, 1.0, 0.0, 0.1056583755),\n","        Species(\"tau\", \"Dirac\", 1, 1.0, 1.0, 0.0, 1.77686),\n","    ]\n","    # Quarks (N=3)\n","    r += [\n","        Species(\"u\", \"Dirac\", 3, 1.0, 1.0, 0.0, 0.0022),\n","        Species(\"d\", \"Dirac\", 3, 1.0, 1.0, 0.0, 0.0047),\n","        Species(\"s\", \"Dirac\", 3, 1.0, 1.0, 0.0, 0.096),\n","        Species(\"c\", \"Dirac\", 3, 1.0, 1.0, 0.0, 1.27),\n","        Species(\"b\", \"Dirac\", 3, 1.0, 1.0, 0.0, 4.18),\n","        Species(\"t\", \"Dirac\", 3, 1.0, 1.0, 0.0, 172.76),\n","    ]\n","    return r\n","\n","def charge_moments(roster: List[Species]) -> Dict[str, float]:\n","    S2F = S4F = 0.0\n","    S2S = S4S = 0.0\n","    for sp in roster:\n","        if sp.kind == \"Dirac\":\n","            S2F += sp.N*(sp.QL**2 + sp.QR**2)\n","            S4F += sp.N*(sp.QL**4 + sp.QR**4)\n","        elif sp.kind == \"scalar\":\n","            S2S += sp.N*(sp.Qphi**2)\n","            S4S += sp.N*(sp.Qphi**4)\n","    return {\"S2F\": S2F, \"S4F\": S4F, \"S2S\": S2S, \"S4S\": S4S}\n","\n","def yukawa_traces(roster: List[Species], v=V_HIGGS_GEV) -> Tuple[float,float,float,Dict[str,dict]]:\n","    Y2 = Y4 = Y2Q2 = 0.0\n","    per_species = {}\n","    for sp in roster:\n","        if sp.kind != \"Dirac\":\n","            continue\n","        y = yukawa_from_mass(sp.mass_GeV, v)\n","        contrib_Y2   = sp.N*(y**2)\n","        contrib_Y4   = sp.N*(y**4)\n","        # App. E.2: Y2(Q^2) uses (Q_L^2 + Q_R^2 + Q_phi^2)\n","        # Note Q_phi is the scalar's charge; in the worked example Q_phi = 1\n","        contrib_Y2Q2 = sp.N*(y**2)*(sp.QL**2 + sp.QR**2 + 1.0)\n","        Y2   += contrib_Y2\n","        Y4   += contrib_Y4\n","        Y2Q2 += contrib_Y2Q2\n","        per_species[sp.name] = {\n","            \"N\": sp.N, \"QL\": sp.QL, \"QR\": sp.QR, \"y\": y,\n","            \"Y2_contrib\": contrib_Y2, \"Y4_contrib\": contrib_Y4, \"Y2Q2_contrib\": contrib_Y2Q2\n","        }\n","    return Y2, Y4, Y2Q2, per_species\n","\n","def two_loop_coefficients(S2F,S2S,S4F,S4S, trace_half=TRACE_NORMALIZATION_HALF):\n","    b1 = (4.0/3.0)*S2F + (1.0/3.0)*S2S\n","    b2 = 4.0*S4F + S4S\n","    if trace_half:\n","        b2 *= 0.5\n","    cY = 2.0\n","    return b1, b2, cY\n","\n","def write_tables(roster, moments, traces, per_species, out_prefix=\"E5_tables\"):\n","    # Table 1: roster (subset of columns used by the appendix)\n","    with open(f\"{out_prefix}_table1_roster.csv\",\"w\",newline=\"\") as f:\n","        w = csv.writer(f)\n","        w.writerow([\"Field\",\"Type\",\"N\",\"QL\",\"QR\",\"Qphi\"])\n","        for sp in roster:\n","            w.writerow([sp.name, sp.kind, sp.N, sp.QL, sp.QR, sp.Qphi])\n","    # Table 2: derived totals\n","    S2F,S2S,S4F,S4S = moments[\"S2F\"], moments[\"S2S\"], moments[\"S4F\"], moments[\"S4S\"]\n","    Y2,Y4,Y2Q2, _ = traces\n","    with open(f\"{out_prefix}_table2_totals.csv\",\"w\",newline=\"\") as f:\n","        w = csv.writer(f)\n","        w.writerow([\"Quantity\",\"Value\"])\n","        w.writerow([\"S2(F)\", S2F])\n","        w.writerow([\"S2(S)\", S2S])\n","        w.writerow([\"S4(F)\", S4F])\n","        w.writerow([\"S4(S)\", S4S])\n","        w.writerow([\"Y2\", Y2])\n","        w.writerow([\"Y4\", Y4])\n","        w.writerow([\"Y2(Q^2)\", Y2Q2])\n","    # Table 3: per-species Yukawa contributions\n","    with open(f\"{out_prefix}_table3_per_species.csv\",\"w\",newline=\"\") as f:\n","        w = csv.writer(f)\n","        w.writerow([\"name\",\"N\",\"QL\",\"QR\",\"y\",\"Y2 contrib\",\"Y4 contrib\",\"Y2(Q^2) contrib\"])\n","        for name, row in per_species.items():\n","            w.writerow([name, row[\"N\"], row[\"QL\"], row[\"QR\"],\n","                        f\"{row['y']:.12g}\", f\"{row['Y2_contrib']:.12g}\",\n","                        f\"{row['Y4_contrib']:.12g}\", f\"{row['Y2Q2_contrib']:.12g}\"])\n","    # manifest\n","    manifest = {\n","        \"v_GeV\": V_HIGGS_GEV,\n","        \"trace_normalization_half\": TRACE_NORMALIZATION_HALF,\n","        \"b_coeffs\": two_loop_coefficients(S2F,S2S,S4F,S4S, TRACE_NORMALIZATION_HALF)\n","    }\n","    with open(f\"{out_prefix}_manifest.json\",\"w\") as f:\n","        json.dump(manifest, f, indent=2)\n","\n","if __name__ == \"__main__\":\n","    roster = make_roster_E5()\n","    moments = charge_moments(roster)\n","    Y2, Y4, Y2Q2, per_species = yukawa_traces(roster)\n","    b1,b2,cY = two_loop_coefficients(moments[\"S2F\"], moments[\"S2S\"], moments[\"S4F\"], moments[\"S4S\"])\n","    # Pretty print (optional)\n","    print(\"Table 1 (roster):\", [(sp.name, sp.kind, sp.N, sp.QL, sp.QR, sp.Qphi) for sp in roster])\n","    print(\"Table 2 (totals):\",\n","          {\"S2F\":moments[\"S2F\"],\"S2S\":moments[\"S2S\"],\"S4F\":moments[\"S4F\"],\"S4S\":moments[\"S4S\"],\n","           \"Y2\":Y2,\"Y4\":Y4,\"Y2(Q^2)\":Y2Q2})\n","    print(\"Two-loop coeffs:\", {\"b1\":b1,\"b2\":b2,\"cY\":cY})\n","    write_tables(roster, moments, (Y2,Y4,Y2Q2, per_species), per_species)\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/"},"id":"SFUcMUOKUWGY","outputId":"bcb34d3b-9c4c-48fa-cadf-02698b3d5839"},"outputs":[{"name":"stdout","output_type":"stream","text":["Target gZ(mu_EW) = 0.357216 (alpha^-1=127.9500, gL=0.653)\n","One-loop saturation estimate (unscreened): gZ(mu_EW) ≤ 0.208\n","One-loop saturation estimate (screened)  : gZ(mu_EW) ≤ 0.359\n","[calibrate_gZ_UV] widening scan → [0.626, 5.7]\n","[calibrate_gZ_UV] widening scan → [0.313, 5.7]\n","[calibrate_gZ_UV] widening scan → [0.157, 5.7]\n","[calibrate_gZ_UV] widening scan → [0.0783, 5.7]\n","[calibrate_gZ_UV] no bracket; using closest approach gZ_UV≈2.8109 (Δ=-1.54e-03)\n","Achieved gZ(mZ)=0.355674 vs target=0.357216  Δ=-1.54e-03\n","Key points (after UV calibration of gZ and y_t):\n","  mu = 91.2 GeV : gZ = 0.355674   lambda = 1.143422   y_top = 0.991552\n","  mu = 1000.0 GeV : gZ = 0.369358   lambda = 1.168788   y_top = 1.000386\n","  mu = 10000.0 GeV : gZ = 0.384125   lambda = 1.192115   y_top = 1.008820\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 660x420 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Saved:\n","  CSV → /content/axis_eft_running.csv\n","  JSON → /content/axis_eft_manifest.json\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 690x460 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["#@title Axis–EFT two-loop RGE with robust UV calibration (gZ, y_t) + screening + guards\n","import numpy as np, json, csv, math\n","import matplotlib.pyplot as plt\n","pi = np.pi\n","\n","# -----------------------------\n","# Invariants and content (Appendix E)\n","# -----------------------------\n","S2F, S2S, S4F, S4S = 42.0, 1.0, 42.0, 1.0     # fermion/scalar charge moments\n","b1 = (4.0/3.0)*S2F + (1.0/3.0)*S2S           # 56.333... (unscreened)\n","b2 = 4.0*S4F + S4S                            # 169       (unscreened)\n","cY = 2.0\n","Qphi2  = 1.0\n","QsumLR = 2.0\n","\n","species = [('e',1),('mu',1),('tau',1),('u',3),('d',3),('s',3),('c',3),('b',3),('t',3)]\n","names   = [s[0] for s in species]\n","N       = np.array([s[1] for s in species], float)\n","idx_t   = names.index('t')\n","\n","# -----------------------------\n","# Scales, seeds, EW targets\n","# -----------------------------\n","mu_hi  = 1.0e16        # Λ_q [GeV]\n","mu_EW  = 91.1876       # m_Z  [GeV]\n","lam_hi = 0.8\n","\n","# EW Yukawas (targets only; used for calibration of y_t)\n","y_EW_target = np.array([\n","    2.94e-6,  6.07e-4, 1.02e-2,\n","    1.26e-5,  2.70e-5, 5.51e-4,\n","    7.29e-3,  2.40e-2, 9.92e-1\n","], float)\n","\n","# ---- Choose gZ target at μ_EW ----\n","use_conventional_alpha = True   # set False to use your internal α\n","gL = 0.653                      # scheme value at μ_EW\n","alpha_inv = 127.95 if use_conventional_alpha else 129.8194\n","e = math.sqrt(4*math.pi/alpha_inv)\n","gZ_target = 1.0 / math.sqrt( 1.0/e**2 - 1.0/gL**2 )\n","print(f\"Target gZ(mu_EW) = {gZ_target:.6f} (alpha^-1={alpha_inv:.4f}, gL={gL:.3f})\")\n","\n","# ---- Intra-morton screening (projector factor) ----\n","enable_screening = True\n","kappa2 = (1.0/3.0) if enable_screening else 1.0\n","kappa4 = kappa2**2\n","\n","def coeffs():\n","    \"\"\"Screened invariants entering the RGEs.\"\"\"\n","    S2F_eff = kappa2 * S2F\n","    S4F_eff = kappa4 * S4F\n","    b1_eff  = (4.0/3.0)*S2F_eff + (1.0/3.0)*S2S\n","    b2_eff  = 4.0*S4F_eff + S4S\n","    QsumLR_eff = kappa2 * QsumLR\n","    return b1_eff, b2_eff, QsumLR_eff\n","\n","# --- 1-loop saturation bound (for diagnostics only) ---\n","def gZ_max_1loop(mu_hi, mu_lo, b1_here):\n","    Delta = (b1_here/(8*np.pi**2)) * np.log(mu_hi/mu_lo)\n","    return 1.0/np.sqrt(Delta)\n","\n","b1_eff, b2_eff, QsumLR_eff = coeffs()\n","gZ_max_unscreened = gZ_max_1loop(mu_hi, mu_EW, b1)\n","gZ_max_screened   = gZ_max_1loop(mu_hi, mu_EW, b1_eff)\n","print(f\"One-loop saturation estimate (unscreened): gZ(mu_EW) ≤ {gZ_max_unscreened:.3f}\")\n","print(f\"One-loop saturation estimate (screened)  : gZ(mu_EW) ≤ {gZ_max_screened:.3f}\")\n","\n","# soft guard (warn-only) against the 1-loop bound\n","soft_guard_mode = \"warn\"   # \"warn\" or \"clamp\"\n","guard_margin    = 1.01     # allow small headroom over 1-loop estimate\n","gZ_max = gZ_max_screened if enable_screening else gZ_max_unscreened\n","if gZ_target > guard_margin * gZ_max:\n","    if soft_guard_mode == \"clamp\":\n","        print(f\"Target {gZ_target:.6f} > {guard_margin:.2f}× 1-loop bound ({gZ_max:.6f}). Clamping.\")\n","        gZ_target = guard_margin * gZ_max\n","    else:\n","        print(f\"Warning: target {gZ_target:.6f} > {guard_margin:.2f}× 1-loop bound ({gZ_max:.6f}). Proceeding.\")\n","\n","# -----------------------------\n","# Safety caps\n","# -----------------------------\n","G_CAP   = 6.0      # cap on |gZ|\n","LAM_CAP = 3.0      # cap on |lambda|\n","Y_CAP   = 3.0      # cap on |y_a|\n","\n","# -----------------------------\n","# β-functions (two-loop subset)\n","# -----------------------------\n","def traces_Y2Y4Y6(y_vec):\n","    Y2   = np.sum(N * y_vec**2)\n","    Y4   = np.sum(N * y_vec**4)\n","    Y6   = np.sum(N * y_vec**6)\n","    return Y2, Y4, Y6\n","\n","def betas(mu, gZ, lam, y_vec):\n","    b1_eff, b2_eff, QsumLR_eff = coeffs()\n","    Y2, Y4, Y6 = traces_Y2Y4Y6(y_vec)\n","    Y2Q2_eff = np.sum(N * y_vec**2 * (QsumLR_eff + Qphi2))\n","    sumy2N = np.sum(N * y_vec**2)\n","\n","    with np.errstate(over='ignore', invalid='ignore', divide='ignore'):\n","        beta_gZ =  (gZ**3/(16*pi**2))*b1_eff \\\n","                 + (gZ**5/(16*pi**2)**2)*b2_eff \\\n","                 - (gZ**3/(16*pi**2)**2)*cY*Y2Q2_eff\n","\n","        beta_l1 = (10*lam**2 + 4*lam*Y2 - 4*Y4 - 4*Qphi2*gZ**2*lam + 6*Qphi2**2*gZ**4)/(16*pi**2)\n","        beta_l2 = (-312*lam**3 + 192*lam*Y4 - 768*Y6)/(16*pi**2)**2\n","        beta_l  = beta_l1 + beta_l2\n","\n","        beta_y  = y_vec * (\n","            (1.5*y_vec**2 + (sumy2N - N * y_vec**2) - 3*QsumLR_eff*gZ**2 - 0.5*lam)/(16*pi**2)\n","            + (-24*y_vec**4 + 12*lam*y_vec**2)/(16*pi**2)**2\n","        )\n","    return beta_gZ, beta_l, beta_y\n","\n","# -----------------------------\n","# Safe integrator in log μ (RK4)\n","# -----------------------------\n","def integrate(mu0, mu1, gZ0, lam0, y0, steps=5000):\n","    mu, gZ, lam, y = float(mu0), float(gZ0), float(lam0), y0.astype(float).copy()\n","    dlog = (np.log(mu1) - np.log(mu0))/steps\n","    out  = np.zeros((steps+1, 3 + len(y0)))\n","    out[0,:] = np.r_[mu, gZ, lam, y]\n","    for i in range(steps):\n","        bg1, bl1, by1 = betas(mu, gZ, lam, y)\n","        if not np.all(np.isfinite([bg1, bl1])) or np.any(~np.isfinite(by1)):\n","            return None\n","        bg2, bl2, by2 = betas(mu*np.exp(0.5*dlog), gZ+0.5*dlog*bg1, lam+0.5*dlog*bl1, y+0.5*dlog*by1)\n","        bg3, bl3, by3 = betas(mu*np.exp(0.5*dlog), gZ+0.5*dlog*bg2, lam+0.5*dlog*bl2, y+0.5*dlog*by2)\n","        bg4, bl4, by4 = betas(mu*np.exp(dlog),     gZ+dlog*bg3,     lam+dlog*bl3,     y+dlog*by3)\n","        gZ  += dlog*(bg1 + 2*bg2 + 2*bg3 + bg4)/6.0\n","        lam += dlog*(bl1 + 2*bl2 + 2*bl3 + bl4)/6.0\n","        y   += dlog*(by1 + 2*by2 + 2*by3 + by4)/6.0\n","        mu  *= np.exp(dlog)\n","        if (not np.isfinite(gZ)) or (not np.isfinite(lam)) or (not np.all(np.isfinite(y))):\n","            return None\n","        if (abs(gZ)>G_CAP) or (abs(lam)>LAM_CAP) or np.any(abs(y)>Y_CAP):\n","            return None\n","        out[i+1,:] = np.r_[mu, gZ, lam, y]\n","    return out\n","\n","def interp_at(mu_target, traj):\n","    # traj[:,0] is decreasing (mu_hi → mu_lo)\n","    mu = traj[:,0]\n","    if mu_target >= mu[0]:  return traj[0]      # UV edge\n","    if mu_target <= mu[-1]: return traj[-1]     # IR edge\n","    # find j s.t. mu[j-1] > mu_target >= mu[j]\n","    j = len(mu) - np.searchsorted(mu[::-1], mu_target, side='left')\n","    x0, x1 = np.log(mu[j-1]), np.log(mu[j])\n","    w = (np.log(mu_target) - x0) / (x1 - x0)\n","    return (1.0 - w) * traj[j-1] + w * traj[j]\n","\n","# -----------------------------\n","# UV seeding for gZ(Λ_q)\n","# -----------------------------\n","def gZ_UV_guess_from_target(gZ_star, b1_eff, mu_hi, mu_star):\n","    # 1/g^2(mu*) = 1/g^2(mu_hi) + (b1/8π^2) ln(mu_hi/mu*)\n","    B = (b1_eff/(8*np.pi**2))*np.log(mu_hi/mu_star)\n","    denom = (1.0/(gZ_star**2)) - B\n","    if denom <= 0 or not np.isfinite(denom):\n","        return None\n","    return 1.0/math.sqrt(denom)\n","\n","# -----------------------------\n","# Calibration helpers\n","# -----------------------------\n","def predict_y_top_at(mu_star, yUV, gZ_UV, steps=4000):\n","    traj = integrate(mu_hi, mu_star, gZ_UV, lam_hi, yUV, steps=steps)\n","    if traj is None: return None\n","    return float(traj[-1, 3 + idx_t])\n","\n","def calibrate_top_yukawa(y_target, mu_star, y_base, gZ_UV,\n","                         bracket=(0.20, 0.90), tol=5e-4, maxit=60):\n","    lo, hi = float(bracket[0]), float(bracket[1])\n","\n","    def f(y_t_UV):\n","        y_try = y_base.copy(); y_try[idx_t] = y_t_UV\n","        ypred = predict_y_top_at(mu_star, y_try, gZ_UV)\n","        if ypred is None: return None\n","        return ypred - y_target\n","\n","    f_lo, f_hi = f(lo), f(hi)\n","    tries = 0\n","    while ( (f_lo is None) or (f_hi is None) or (np.isnan(f_lo) or np.isnan(f_hi)) or (f_lo*f_hi > 0) ) and tries < 10:\n","        lo = max(0.05, 0.8*lo)\n","        hi = min(1.25, 1.1*hi)\n","        f_lo, f_hi = f(lo), f(hi); tries += 1\n","    if (f_lo is None) or (f_hi is None) or (np.isnan(f_lo) or np.isnan(f_hi)) or (f_lo*f_hi > 0):\n","        return None\n","\n","    for _ in range(maxit):\n","        mid = 0.5*(lo+hi)\n","        f_mid = f(mid)\n","        if (f_mid is None) or np.isnan(f_mid):\n","            mid = 0.5*(lo+mid); f_mid = f(mid)\n","            if (f_mid is None) or np.isnan(f_mid): return None\n","        if abs(f_mid) < tol:\n","            y_best = y_base.copy(); y_best[idx_t] = mid\n","            return y_best\n","        if f_lo * f_mid <= 0:\n","            hi, f_hi = mid, f_mid\n","        else:\n","            lo, f_lo = mid, f_mid\n","    y_best = y_base.copy(); y_best[idx_t] = 0.5*(lo+hi)\n","    return y_best\n","\n","def calibrate_gZ_UV(gZ_target, mu_star, y_base,\n","                    gZ_scan=(None, None, 31),  # lo/hi auto if None\n","                    tol=5e-4, maxit=40):\n","    # seed near 1-loop guess; cap scan to avoid crazy gZ**5 overflows\n","    g0 = gZ_UV_guess_from_target(gZ_target, coeffs()[0], mu_hi, mu_star)\n","    if g0 is None or not np.isfinite(g0): g0 = 2.5\n","    lo_scan = max(0.3*g0, 0.05) if gZ_scan[0] is None else gZ_scan[0]\n","    hi_scan = min(3.0*g0, 0.95*G_CAP) if gZ_scan[1] is None else min(gZ_scan[1], 0.95*G_CAP)\n","    ngrid   = gZ_scan[2]\n","\n","    widen_tries = 0\n","    best = None  # (gUV, f, y_cal) with minimal |f|\n","\n","    while True:\n","        xs = np.geomspace(lo_scan, hi_scan, ngrid)\n","        vals = []\n","        for gUV in xs:\n","            y_cal = calibrate_top_yukawa(y_EW_target[idx_t], mu_star, y_base, gUV)\n","            if y_cal is None: continue\n","            traj = integrate(mu_hi, mu_star, gUV, lam_hi, y_cal, steps=5000)\n","            if traj is None:  continue\n","            g_est = float(traj[-1, 1])\n","            if not np.isfinite(g_est): continue\n","            f = g_est - gZ_target\n","            vals.append((gUV, f, y_cal))\n","\n","        vals.sort(key=lambda t: t[0])\n","\n","        if vals:\n","            cand = min(vals, key=lambda t: abs(t[1]))\n","            if (best is None) or (abs(cand[1]) < abs(best[1])): best = cand\n","\n","            # try bracket\n","            for (g1,f1,y1),(g2,f2,y2) in zip(vals[:-1], vals[1:]):\n","                if np.isfinite(f1) and np.isfinite(f2) and (f1*f2 < 0):\n","                    def f_pair(gUV):\n","                        y_cal = calibrate_top_yukawa(y_EW_target[idx_t], mu_star, y_base, gUV)\n","                        if y_cal is None: return None, None\n","                        traj = integrate(mu_hi, mu_star, gUV, lam_hi, y_cal, steps=5000)\n","                        if traj is None:  return None, None\n","                        return float(traj[-1,1]) - gZ_target, y_cal\n","\n","                    lo, hi = g1, g2\n","                    f_lo, f_hi = f1, f2\n","                    y_saved = y1\n","                    for _ in range(maxit):\n","                        mid = 0.5*(lo+hi)\n","                        f_mid, y_mid = f_pair(mid)\n","                        if (f_mid is None) or (not np.isfinite(f_mid)):\n","                            mid = 0.5*(lo+mid)\n","                            f_mid, y_mid = f_pair(mid)\n","                            if (f_mid is None) or (not np.isfinite(f_mid)): break\n","                        if abs(f_mid) < tol:\n","                            return mid, y_mid\n","                        if f_lo * f_mid <= 0:\n","                            hi, f_hi, y_saved = mid, f_mid, y_mid\n","                        else:\n","                            lo, f_lo, y_saved = mid, f_mid, y_mid\n","                    return mid, y_saved  # last best inside bracket\n","\n","        # no bracket yet → widen sanely\n","        widen_tries += 1\n","        if widen_tries > 4:\n","            if best is not None:\n","                print(f\"[calibrate_gZ_UV] no bracket; using closest approach gZ_UV≈{best[0]:.4f} (Δ={best[1]:+.2e})\")\n","                return best[0], best[2]\n","            raise RuntimeError(\"Auto-bracket failed for gZ(Λ_q); no valid samples.\")\n","\n","        lo_scan = max(0.5*lo_scan, 0.05)\n","        hi_scan = min(1.6*hi_scan, 0.95*G_CAP)\n","        ngrid   = max(ngrid, 31)\n","        print(f\"[calibrate_gZ_UV] widening scan → [{lo_scan:.3g}, {hi_scan:.3g}]\")\n","\n","# -----------------------------\n","# Calibrate, run, report, save\n","# -----------------------------\n","# base Yukawas at Λ_q (benign): downweight light; top will be calibrated anyway\n","yUV_base = 0.3 * y_EW_target.copy()\n","yUV_base[idx_t] = 0.50\n","\n","# calibrate gZ(Λ_q) and y_t(Λ_q)\n","gZ_UV_cal, yUV_cal = calibrate_gZ_UV(gZ_target, mu_EW, yUV_base,\n","                                     gZ_scan=(None, None, 31), tol=5e-4, maxit=40)\n","\n","# achievement check exactly at mZ\n","traj_EW = integrate(mu_hi, mu_EW, gZ_UV_cal, lam_hi, yUV_cal, steps=6000)\n","if traj_EW is None:\n","    raise RuntimeError(\"EW trajectory failed; try loosening caps or seeds.\")\n","gZ_ach  = float(traj_EW[-1,1])\n","yt_ach  = float(traj_EW[-1, 3 + idx_t])\n","print(f\"Achieved gZ(mZ)={gZ_ach:.6f} vs target={gZ_target:.6f}  Δ={gZ_ach-gZ_target:+.2e}\")\n","\n","# final long trajectory (down to the smallest reported μ)\n","mu_points   = [mu_EW, 1.0e3, 1.0e4]\n","mu_lo_final = min(mu_points)\n","traj = integrate(mu_hi, mu_lo_final, gZ_UV_cal, lam_hi, yUV_cal, steps=8000)\n","if traj is None:\n","    raise RuntimeError(\"Final trajectory failed safety checks; try loosening caps or seeds.\")\n","\n","def report(mu_star):\n","    v = interp_at(mu_star, traj)\n","    print(f\"  mu = {mu_star:.1f} GeV : gZ = {v[1]:.6f}   lambda = {v[2]:.6f}   y_top = {v[3+idx_t]:.6f}\")\n","\n","print(\"Key points (after UV calibration of gZ and y_t):\")\n","for mu_star in [mu_EW, 1.0e3, 1.0e4]:\n","    report(mu_star)\n","\n","# plot\n","fig, ax = plt.subplots(figsize=(6.6,4.2))\n","ax.semilogx(traj[:,0], traj[:,1], label=r'$g_Z$')\n","ax.semilogx(traj[:,0], traj[:,2], label=r'$\\lambda$')\n","ax.semilogx(traj[:,0], traj[:,3 + idx_t], label=r'$y_t$')\n","ax.set_xlabel(r'$\\mu\\ \\mathrm{[GeV]}$'); ax.set_ylabel('coupling')\n","ax.grid(True, which='both', ls=':'); ax.legend(); plt.show()\n","\n","fig.savefig('/content/fig_axis_eft_running_gZ_lambda_yt.png', dpi=300, bbox_inches='tight')\n","fig.savefig('/content/fig_axis_eft_running_gZ_lambda_yt.pdf', bbox_inches='tight')\n","\n","# save CSV + JSON\n","csv_path  = '/content/axis_eft_running.csv'\n","json_path = '/content/axis_eft_manifest.json'\n","with open(csv_path, 'w', newline='') as f:\n","    w = csv.writer(f); w.writerow(['mu[GeV]','gZ','lambda'] + [f'y_{n}' for n in names])\n","    for row in traj: w.writerow([row[0], row[1], row[2]] + list(row[3:]))\n","\n","manifest = {\n","    'mu_hi': mu_hi, 'lam_hi': lam_hi, 'gZ_UV_cal': float(gZ_UV_cal),\n","    'y_UV': {n: float(v) for n,v in zip(names, yUV_cal)},\n","    'targets': {'mu_EW[GeV]': float(mu_EW), 'gZ_target': float(gZ_target), 'y_t_target': float(y_EW_target[idx_t])},\n","    'achieved': {'gZ(mZ)': float(gZ_ach), 'y_t(mZ)': float(yt_ach)},\n","    'invariants': {\n","        'S2F': S2F, 'S2S': S2S, 'S4F': S4F, 'S4S': S4S,\n","        'b1_eff': float(b1_eff), 'b2_eff': float(b2_eff), 'cY': cY, 'QsumLR_eff': float(QsumLR_eff),\n","        'screening_kappa2': float(kappa2)\n","    },\n","    'requested_targets': {'alpha_inv': float(alpha_inv), 'gL': float(gL)},\n","    'notes': 'Two-loop Abelian β_gZ with intra-morton screening; robust UV calibration with seeded/capped scan and closest-approach fallback; RK4 in log μ; safety caps.'\n","}\n","with open(json_path, 'w') as f: json.dump(manifest, f, indent=2)\n","print(f\"\\nSaved:\\n  CSV → {csv_path}\\n  JSON → {json_path}\")\n","\n","#------------------------------------------------------------\n","#1L RG‑improved V_eff(Φ) in the EFT window (for §4.3) follows\n","#------------------------------------------------------------\n","\n","assert 'traj' in globals(), \"Run the RGE cell first to define 'traj'.\"\n","Q_PHI = 1.0  # scalar charge in the EFT\n","\n","# Log-linear interpolation of couplings at chosen μ\n","def _interp_many(mu_pts):\n","    mu_grid = traj[:,0]; Lmu = np.log(mu_grid); x = np.log(mu_pts)\n","    def I(col): return np.interp(x, Lmu, col)\n","    gZ  = I(traj[:,1]); lam = I(traj[:,2])\n","    Y   = np.vstack([I(traj[:,3+i]) for i in range(len(names))]).T  # shape (len(mu_pts), n_species)\n","    return gZ, lam, Y\n","\n","def Veff(phi, kappa=1.0):\n","    # RG-improvement: choose μ = kappa * |Φ|, clipped to the RGE grid\n","    mu = np.clip(kappa*phi, mu_EW, mu_hi*0.999)\n","    gZ, lam, y = _interp_many(mu)\n","\n","    # Field-dependent masses\n","    mH2 = 3.0*lam*phi**2          # radial scalar\n","    mG2 = 1.0*lam*phi**2          # would-be Goldstone\n","    mV2 = (Q_PHI**2)*(gZ**2)*phi**2\n","    mF2 = 0.5*(y**2)*(phi[:,None]**2)  # Dirac fermions, include multiplicities via N\n","\n","    eps = 1e-30\n","    def CW(m2, c):\n","        m2p = np.maximum(m2, eps)\n","        return m2p**2 * (np.log(m2p / (mu[:,None]**2)) - c)\n","\n","    V0  = 0.25*lam*phi**4\n","    V1s = CW(mH2[:,None], 1.5) + CW(mG2[:,None], 1.5)          # scalars\n","    V1v = 3.0 * CW(mV2[:,None], 5.0/6.0)                       # vector (3 pol.)\n","    V1f = -4.0 * (N[None,:] * CW(mF2, 1.5))                    # Dirac fermions, N multiplicity\n","\n","    return V0 + (V1s.sum(axis=1) + V1v.sum(axis=1) + V1f.sum(axis=1)) / (64*np.pi**2)\n","\n","# Domain and plot\n","phis = np.geomspace(mu_EW, 0.8*mu_hi, 400)\n","fig, ax = plt.subplots(figsize=(6.9, 4.6))\n","for k in [0.5, 1.0, 2.0]:\n","    V = Veff(phis, kappa=k)\n","    V -= V[0]  # set V at μ≈M_Z to 0 for display\n","    ax.plot(phis, V, label=rf'$\\mu={k}\\,|\\Phi|$')\n","\n","ax.axvspan(0.8*mu_hi, mu_hi, color='0.92', label='near cutoff')\n","ax.axvline(mu_hi, ls=':', lw=1.2)\n","ax.set_xscale('log'); ax.grid(True, which='both', ls=':', alpha=0.35)\n","ax.set_xlabel(r'$|\\Phi|\\,[\\mathrm{GeV}]$'); ax.set_ylabel(r'$V_{\\mathrm{eff}}(\\Phi)$ (arb. offset)')\n","ax.legend(frameon=False, fontsize=9)\n","fig.tight_layout()\n","fig.savefig(\"fig_Veff_RG1L.png\", dpi=600, bbox_inches=\"tight\")\n","plt.show()\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"tZ9oY5EUAq6J","outputId":"74aa0e1c-74f4-4858-a09e-371d384177f5"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 690x460 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# --- RG-improved V_eff(Φ) with units scale folded into the y-label ---\n","# --- Run above code before running this ---\n","phis = np.geomspace(mu_EW, 0.8*mu_hi, 400)\n","ks   = [0.5, 1.0, 2.0]\n","\n","# 1) Probe V to pick an automatic decade scale (e.g. 10^63)\n","V_all = []\n","for k in ks:\n","    Vk = Veff(phis, kappa=k).copy()\n","    Vk -= Vk[0]\n","    V_all.append(Vk)\n","V_all = np.concatenate(V_all)\n","\n","exp  = int(np.floor(np.log10(np.nanmax(np.abs(V_all)) + 1e-300)))\n","exp3 = int(3 * np.floor(exp/3))          # round to multiple of 3, e.g. 63\n","scale = 10.0**exp3\n","scale_str = f'10^{exp3}'                 # <- NO dollar signs here\n","\n","# 2) Plot V/scale and put the factor in the ylabel\n","fig, ax = plt.subplots(figsize=(6.9, 4.6))\n","for k in ks:\n","    V = Veff(phis, kappa=k)\n","    V -= V[0]\n","    ax.plot(phis, V/scale, lw=1.8, label=rf'$\\mu={k}\\,|\\Phi|$')\n","\n","ax.axvspan(0.8*mu_hi, mu_hi, color='0.92', label='near cutoff')\n","ax.axvline(mu_hi, ls=':', lw=1.2)\n","\n","ax.set_xscale('log'); ax.grid(True, which='both', ls=':', alpha=0.35)\n","ax.set_xlabel(r'$|\\Phi|\\,[\\mathrm{GeV}]$')\n","\n","# Single math block; no nested $...$\n","ax.set_ylabel(rf'$V_{{\\mathrm{{eff}}}}(\\Phi)\\,[\\mathrm{{GeV}}^4]/{scale_str}$')\n","\n","ax.legend(frameon=False, fontsize=9)\n","fig.tight_layout()\n","fig.savefig(\"fig_Veff_RG1L_unitscaled.png\", dpi=600, bbox_inches=\"tight\")\n","plt.show()\n"]},{"cell_type":"code","source":["# Finite-Temperature Potential figure for the Axis UV paper\n","# Reproduces the V_eff/T^4 vs rho/T plot and saves PDF/PNG to figs/\n","\n","import os, math\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# -----------------------------\n","# Parameters (edit as needed)\n","# -----------------------------\n","D    = 0.10     # thermal mass coefficient (>0)\n","E    = 0.05     # bosonic cubic coefficient (>=0)\n","lamT = 0.10     # quartic at temperature T (>0)\n","\n","temps = [1.02, 1.00, 0.98]  # values of T/Tc to plot\n","Tc = 1.0                    # choose units so Tc=1\n","\n","# -----------------------------\n","# Derived quantities\n","# -----------------------------\n","# Degeneracy condition: T_c^2 = T0^2 / (1 - E^2/(D*lamT))  => T0/Tc = sqrt(1 - E^2/(D*lamT))\n","T0_over_Tc = math.sqrt(max(1.0 - (E**2)/(D*lamT), 0.0))\n","\n","# Broken minimum at Tc: rho_c/Tc = 2E / lamT\n","rho_c_over_Tc = 2.0 * E / lamT\n","\n","print(f\"T0/Tc = {T0_over_Tc:.6f}\")\n","print(f\"rho_c/Tc = {rho_c_over_Tc:.6f}\")\n","print(f\"First-order condition (E^2 < D*lamT): {E**2 < D*lamT}\")\n","\n","# -----------------------------\n","# Potential and plotting\n","# -----------------------------\n","def Veff(rho, T, D, E, lamT, T0_over_Tc):\n","    \"\"\"V_eff(ρ;T) = D (T^2 - T0^2) ρ^2 - E T ρ^3 + (lamT/4) ρ^4, with Tc=1 and T0/Tc given.\"\"\"\n","    T0 = T0_over_Tc  # since Tc=1\n","    return D*(T**2 - T0**2)*rho**2 - E*T*rho**3 + 0.25*lamT*rho**4\n","\n","def Veff_dimless(x, T_over_Tc, D, E, lamT, T0_over_Tc):\n","    \"\"\"Dimensionless: x = ρ/T, y = V_eff/T^4; with Tc=1 so T_over_Tc = T.\"\"\"\n","    T   = T_over_Tc\n","    rho = x*T\n","    return Veff(rho, T, D, E, lamT, T0_over_Tc) / (T**4)\n","\n","# grid\n","x = np.linspace(0.0, 2.0, 600)\n","\n","plt.figure(figsize=(6, 4.2))\n","for T_over_Tc in temps:\n","    y = Veff_dimless(x, T_over_Tc, D, E, lamT, T0_over_Tc)\n","    plt.plot(x, y, label=fr\"$T/T_c={T_over_Tc:.2f}$\")\n","\n","# Mark rho_c/Tc at T=Tc\n","plt.axvline(rho_c_over_Tc, linestyle=\"--\", linewidth=1.0)\n","\n","plt.xlabel(r\"$\\rho/T$\")\n","plt.ylabel(r\"$V_{\\mathrm{eff}}/T^4$\")\n","# plt.title(fr\"Finite-temperature potential: $D={D}$, $E={E}$, $\\lambda_T={lamT}$, $T_0/T_c={T0_over_Tc:.3f}$\")\n","plt.legend(frameon=False)\n","plt.tight_layout()\n","\n","# save\n","os.makedirs(\"figs\", exist_ok=True)\n","pdf = \"figs/finite_T_potential.pdf\"\n","png = \"figs/finite_T_potential.png\"\n","# plt.savefig(pdf, bbox_inches=\"tight\")\n","plt.savefig(png, bbox_inches=\"tight\")\n","print(\"Saved:\", pdf, \"and\", png)\n","\n","# -----------------------------\n","# Optional: thin-wall helpers\n","# -----------------------------\n","def sigma_Tc(E, lamT, Tc=1.0):\n","    # Surface tension at Tc used in the text\n","    return (4*E**3 * Tc**3) / (3*math.sqrt(2) * lamT**(2.5))\n","\n","def latent_heat(D, E, lamT, Tc=1.0):\n","    # Latent heat L at Tc used in the text\n","    return (8*E**2 * Tc**4 / lamT**3) * (D*lamT - E**2)\n","\n","sig = sigma_Tc(E, lamT)\n","L   = latent_heat(D, E, lamT)\n","print(f\"sigma(Tc) = {sig:.6e}\")\n","print(f\"L         = {L:.6e}\")\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":530},"id":"QFNUMFtaaRs5","executionInfo":{"status":"ok","timestamp":1760188710463,"user_tz":240,"elapsed":438,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"0604e0e2-5251-4920-ae54-7ae9bb880d3c"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["T0/Tc = 0.866025\n","rho_c/Tc = 1.000000\n","First-order condition (E^2 < D*lamT): True\n","Saved: figs/finite_T_potential.pdf and figs/finite_T_potential.png\n","sigma(Tc) = 3.726780e-02\n","L         = 1.500000e-01\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x420 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPan/0pDT+TggMdNEIKQkdI"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}