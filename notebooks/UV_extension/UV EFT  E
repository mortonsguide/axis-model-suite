{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNSfIN5s8Ma6wd/MQs1AACU"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# ===========================================\n","# Axis UV→EFT: Robust \"Tables + Match & Run\"\n","# ===========================================\n","\n","import os, math, json, pathlib\n","from dataclasses import dataclass\n","from typing import List, Dict, Tuple, Any\n","import numpy as np\n","import pandas as pd\n","from scipy.integrate import solve_ivp\n","from scipy.optimize import brentq\n","import matplotlib.pyplot as plt\n","\n","# ---------- CONFIG ----------\n","OUT_DIR = \"artifacts\"\n","MODE = \"calibrate_minimal\"\n","auto_qf_scale = True\n","save_plots = True\n","\n","# Scales / constants\n","MU_EW = 91.1876\n","LAMBDA_Q = 1.0e12\n","gL_muEW = 0.6529\n","v_phi = 246.22\n","alphaEW_inv_target = 127.95\n","\n","# Gauged screening for Yukawas\n","USE_GAUGE_SCREEN = True\n","G2_EW, G3_EW = 0.6529, 1.220\n","C2_LEPTON = 3.0/4.0\n","C2_QUARK = 3.0/4.0\n","C3_QUARK = 4.0/3.0\n","def is_quark(nm): return nm in {\"u\",\"d\",\"s\",\"c\",\"b\",\"t\"}\n","\n","# EFT scalar charge\n","Q_PHI = 1.0\n","\n","# Global rescale for fermion charges\n","QF_SCALE = 1.0\n","\n","# Dirac species roster\n","DIRAC_ROSTER = [\n","    (\"e\", 1, -0.5, -1.0, 1), (\"mu\", 1, -0.5, -1.0, 1), (\"tau\", 1, -0.5, -1.0, 1),\n","    (\"nu_e\", 1, -0.5, 0.0, 1), (\"nu_mu\", 1, -0.5, 0.0, 1), (\"nu_tau\",1, -0.5, 0.0, 1),\n","    (\"u\", 3, 1.0/6, 2.0/3, 1), (\"d\", 3, 1.0/6, -1.0/3, 1), (\"s\", 3, 1.0/6, -1.0/3, 1),\n","    (\"c\", 3, 1.0/6, 2.0/3, 1), (\"b\", 3, 1.0/6, -1.0/3, 1), (\"t\", 3, 1.0/6, 2.0/3, 1),\n","]\n","\n","# Mass inputs (GeV)\n","MASSES_GEV = {\n","    \"e\": 0.00051099895, \"mu\": 0.1056583755, \"tau\": 1.77686, \"nu_e\": 1e-12, \"nu_mu\": 1e-12, \"nu_tau\": 1e-12,\n","    \"u\": 0.0022, \"d\": 0.0047, \"s\": 0.096, \"c\": 1.27, \"b\": 4.18, \"t\": 172.76\n","}\n","\n","# UV → EFT matching inputs\n","OMEGA_PROJ = 1.0\n","DELTA_Z_FIN = 0.0\n","gNA_Lq_plus = 3.0\n","\n","# Yukawa scale and weights\n","Xi_global = 2.044e-6\n","UV_WEIGHTS = {}\n","\n","# Calibration options\n","REF_SPECIES = \"t\"\n","TARGET_MASS = MASSES_GEV.get(REF_SPECIES, 172.76)\n","\n","# Quartic at Λq-\n","lam_Lq_seed = 0.8\n","\n","# Background parameters\n","B_PARAMS = dict(v=1.0, tau=1.0, tau_p=0.2, tau_pp=0.5, kappa=1.0, eta=1.0, eta_p=0.0,\n","                eta_pp=0.0, q=0.0, f=1.0, theta0=0.0, cos_chi=0.1, volB0=1.0, m0_sq=0.0)\n","\n","# Integration controls\n","N_EVAL_POINTS = 500\n","MAX_STEP = 0.10\n","RTOL, ATOL = 1e-6, 1e-8\n","BLOWUP_CUTOFF = 4.0\n","LAMBDA_CUTOFF = 10.0\n","SUBDIVISION_SEQ = tuple(2**i for i in range(1, 9))\n","\n","# --- Comparison optics ---\n","COMPARE_AT_MZ = True   # if False, fall back to MASSES_GEV (low-scale PDG)\n","\n","# Reference masses at μ = MZ (approximate MSbar; replace with your source table if you like)\n","MZ_MASSES_GEV = {\n","    \"e\": 0.00051099895, \"mu\": 0.1056583755, \"tau\": 1.77686,\n","    \"nu_e\": 1e-12, \"nu_mu\": 1e-12, \"nu_tau\": 1e-12,\n","    \"u\": 0.00138, \"d\": 0.00282, \"s\": 0.057, \"c\": 0.62, \"b\": 2.82, \"t\": 172.8\n","}\n","\n","# ---------- Utilities ----------\n","Path = pathlib.Path\n","Path(OUT_DIR).mkdir(parents=True, exist_ok=True)\n","SIXTEEN_PI2 = 16.0*math.pi**2\n","\n","@dataclass\n","class Species:\n","    name: str; N: int; QL: float; QR: float; active: bool\n","\n","def roster_to_species(roster: List[Tuple], qf: float) -> List[Species]:\n","    return [Species(n, N, qf*QL, qf*QR, bool(inc)) for (n,N,QL,QR,inc) in roster]\n","\n","def yukawa_inputs() -> Dict[str,float]:\n","    return {k: math.sqrt(2.0)*float(m)/v_phi for k,m in MASSES_GEV.items() if m>0}\n","\n","# ---------- Appendix E.5/E.6 helpers ----------\n","def build_E5_table(species: List[Species], Qphi: float) -> pd.DataFrame:\n","    rows = [{\"Field\": r\"$\\Phi$\", \"Type\": \"scalar\", \"N\": 1, \"QL\": \"---\", \"QR\": \"---\", \"Qphi\": f\"{Qphi:g}\"}]\n","    rows.extend([{\"Field\": sp.name, \"Type\": \"Dirac\", \"N\": sp.N, \"QL\": f\"{sp.QL:g}\", \"QR\": f\"{sp.QR:g}\", \"Qphi\": \"---\"}\n","                 for sp in species if sp.active])\n","    df = pd.DataFrame(rows)\n","    df.to_csv(f\"{OUT_DIR}/E5_EFT_content.csv\", index=False)\n","    return df\n","\n","def compute_invariants(species: List[Species], Qphi: float, y_map: Dict[str,float], write_csv=True):\n","    active_species = [s for s in species if s.active]\n","    S2F = sum(sp.N*(sp.QL**2 + sp.QR**2) for sp in active_species)\n","    S4F = sum(sp.N*(sp.QL**4 + sp.QR**4) for sp in active_species)\n","    S2S, S4S = Qphi**2, Qphi**4\n","    Y2 = Y4 = Y2Q = 0.0\n","    breakdown = []\n","    for sp in active_species:\n","        y = float(y_map.get(sp.name, 0.0))\n","        y2_contrib = sp.N * y**2\n","        y4_contrib = sp.N * y**4\n","        y2q_contrib = y2_contrib * (sp.QL**2 + sp.QR**2 + Qphi**2)\n","        Y2 += y2_contrib; Y4 += y4_contrib; Y2Q += y2q_contrib\n","        breakdown.append({\"name\": sp.name, \"N\": sp.N, \"QL\": sp.QL, \"QR\": sp.QR, \"y\": y,\n","                          \"contrib_Y2\": y2_contrib, \"contrib_Y4\": y4_contrib, \"contrib_Y2Q\": y2q_contrib})\n","    df_tot = pd.DataFrame([\n","        {\"Quantity\": \"S2(F)\", \"Value\": S2F}, {\"Quantity\": \"S2(S)\", \"Value\": S2S},\n","        {\"Quantity\": \"S4(F)\", \"Value\": S4F}, {\"Quantity\": \"S4(S)\", \"Value\": S4S},\n","        {\"Quantity\": \"Y2\", \"Value\": Y2}, {\"Quantity\": \"Y4\", \"Value\": Y4},\n","        {\"Quantity\": \"Y2(Q^2)\", \"Value\": Y2Q}])\n","    if write_csv:\n","        df_tot.to_csv(f\"{OUT_DIR}/E6_invariants_totals.csv\", index=False)\n","        pd.DataFrame(breakdown).to_csv(f\"{OUT_DIR}/E6_species_breakdown.csv\", index=False)\n","    return df_tot, breakdown\n","\n","def build_B_numbers(p: Dict[str,float]) -> pd.DataFrame:\n","    v,tau,tau_p,tau_pp,kappa,eta,eta_p,eta_pp,q,f,theta0,coschi,volB0,m0_sq = [p.get(k) for k in\n","        ['v','tau','tau_p','tau_pp','kappa','eta','eta_p','eta_pp','q','f','theta0','cos_chi','volB0','m0_sq']]\n","    Ms_sq = m0_sq + 3*tau_pp*v**2 - 0.5*(q+f*theta0)**2 * (eta_pp/eta**2 - 2*eta_p**2/eta**3) * volB0\n","    MB_sq = tau + 2*kappa*v**2\n","    cV = -coschi/(2*tau**2)\n","    gPhiV = cV*tau_p\n","    dfB = pd.DataFrame([{\"Quantity\": \"M_s^2\", \"Value\": Ms_sq}, {\"Quantity\": \"M_B^2\", \"Value\": MB_sq},\n","                        {\"Quantity\": \"c_V\", \"Value\": cV}, {\"Quantity\": r\"g_{\\Phi V}\", \"Value\": gPhiV}])\n","    dfB.to_csv(f\"{OUT_DIR}/B_numbers.csv\", index=False)\n","    return dfB\n","\n","# ---------- One-loop floor ----------\n","def _moments_for_roster(species: List[Species], Qphi: float):\n","    S2F = sum(sp.N*(sp.QL**2 + sp.QR**2) for sp in species if sp.active)\n","    S2S = Qphi**2\n","    b1 = (4/3)*S2F + (1/3)*S2S\n","    return b1\n","\n","def ir_floor_estimate(species: List[Species], Qphi: float, mu_hi=LAMBDA_Q, mu_lo=MU_EW, gL=gL_muEW):\n","    b1 = _moments_for_roster(species, Qphi)\n","    Delta = (b1/(8*math.pi**2))*math.log(mu_hi/mu_lo)\n","    gZ_sat = 1/math.sqrt(max(Delta, 1e-30))\n","    e2_sat = (gL**2 * gZ_sat**2) / (gL**2 + gZ_sat**2)\n","    alpha_sat = e2_sat/(4*math.pi)\n","    return gZ_sat, alpha_sat\n","\n","def build_uv_weights_from_masses(species: List[Species], ref=\"mu\"):\n","    m_ref = MASSES_GEV[ref]\n","    return {s.name: MASSES_GEV.get(s.name, 1e-12*m_ref) / m_ref for s in species if s.active}\n","\n","# ---------- β-functions (Corrected) ----------\n","def moments_from_yvec(species: List[Species], Qphi: float, names: List[str], y_vec: np.ndarray):\n","    active_species = [s for s in species if s.active]\n","    name_to_sp = {s.name: s for s in active_species}\n","    S2F = sum(sp.N*(sp.QL**2 + sp.QR**2) for sp in active_species)\n","    S4F = sum(sp.N*(sp.QL**4 + sp.QR**4) for sp in active_species)\n","    S2S, S4S = Qphi**2, Qphi**4\n","    Y2 = Y4 = Y2Q = 0.0\n","    for i, nm in enumerate(names):\n","        sp, y = name_to_sp[nm], float(y_vec[i])\n","        y2_contrib = sp.N * y**2\n","        Y2 += y2_contrib; Y4 += sp.N * y**4; Y2Q += y2_contrib * (sp.QL**2 + sp.QR**2 + Qphi**2)\n","    return S2F, S2S, S4F, S4S, Y2, Y4, Y2Q\n","\n","def rge_system(t, state, species: List[Species], Qphi: float, names: List[str]):\n","    gZ, lam, yv = state[0], state[1], state[2:]\n","    S2F,S2S,S4F,S4S,Y2,Y4,Y2Q = moments_from_yvec(species, Qphi, names, yv)\n","\n","    b1 = (4/3)*S2F + (1/3)*S2S\n","    b2 = 4*S4F + S4S\n","    dgZdt = (gZ**3/SIXTEEN_PI2)*b1 + (gZ**3/(SIXTEEN_PI2**2))*(b2*gZ**2 - 2*Y2Q)\n","\n","    dlamdt = (1/SIXTEEN_PI2)*(10*lam**2 + 4*lam*Y2 - 4*Y4 - 4*lam*Qphi**2*gZ**2 + 6*Qphi**4*gZ**4)\n","\n","    dydt = np.zeros_like(yv)\n","    g2sq,g3sq = (G2_EW**2,G3_EW**2) if USE_GAUGE_SCREEN else (0,0)\n","    name_to_sp = {s.name: s for s in species if s.active}\n","    for i, nm in enumerate(names):\n","        sp = name_to_sp[nm]\n","        sum_other_y_sq_N = Y2 - sp.N * yv[i]**2\n","        Qsum2 = sp.QL**2 + sp.QR**2\n","        C2 = C2_QUARK if is_quark(nm) else C2_LEPTON\n","        C3 = C3_QUARK if is_quark(nm) else 0.0\n","        coeff = 1.5*yv[i]**2 + 0.5*sum_other_y_sq_N - 3*Qsum2*gZ**2 - 0.5*lam - C2*g2sq - C3*g3sq\n","        dydt[i] = (yv[i]/SIXTEEN_PI2)*coeff\n","    return np.concatenate(([dgZdt, dlamdt], dydt))\n","\n","# --- Event handling ---\n","def _blowup_event(t, y, cutoff=BLOWUP_CUTOFF):\n","    y_abs_max = np.max(np.abs(y[2:])) if len(y) > 2 else 0.0\n","    margin = min(cutoff - abs(y[0]), cutoff - y_abs_max, LAMBDA_CUTOFF - abs(y[1]), y[1])\n","    return margin\n","_blowup_event.terminal = True; _blowup_event.direction = -1\n","\n","# ---------- RGE driver ----------\n","def _try_solve_segment(f, a, b, state, method, rtol, atol, max_step):\n","    try:\n","        sol = solve_ivp(f, (a,b), state, method=method, rtol=rtol, atol=atol, max_step=abs(max_step),\n","                        t_eval=[b], jac=None, events=_blowup_event)\n","        if sol.status == 1:\n","            return False, None, \"vacuum_instability\" if sol.y[1,-1]<0 else \"blowup\"\n","        return (True, sol.y[:,-1], \"ok\") if sol.success else (False, None, sol.message)\n","    except Exception as e: return False, None, f\"{method} raised: {e}\"\n","\n","def run_once_multi(gZ_Lq, lam_Lq, yLq_vec, species: List[Species], Qphi, mu_hi=LAMBDA_Q, mu_lo=MU_EW):\n","    names = [s.name for s in species if s.active]\n","    state = np.concatenate(([gZ_Lq, lam_Lq], yLq_vec))\n","    t_grid = np.linspace(np.log(mu_hi), np.log(mu_lo), N_EVAL_POINTS)\n","    states = np.zeros((len(state), len(t_grid))); states[:, 0] = state\n","    f = lambda t,y: rge_system(t,y,species,Qphi,names)\n","\n","    for k in range(len(t_grid)-1):\n","        a,b = t_grid[k], t_grid[k+1]\n","        ok, yb, msg = _try_solve_segment(f, a, b, state, \"Radau\", RTOL, ATOL, MAX_STEP)\n","        if not ok and msg not in [\"blowup\", \"vacuum_instability\"]:\n","            ok, yb, msg = _try_solve_segment(f, a, b, state, \"BDF\", RTOL, ATOL, MAX_STEP)\n","        if not ok:\n","             raise RuntimeError(f\"Flow failed due to {msg} at mu={np.exp(a):.2e} GeV.\")\n","        state = yb; states[:, k+1] = state\n","    gZ_EW, lam_EW, yE_EW = states[0, -1], states[1, -1], states[2:, -1]\n","    e2_EW = (gL_muEW**2 * gZ_EW**2)/(gL_muEW**2 + gZ_EW**2)\n","    alpha_EW = e2_EW/(4*math.pi)\n","    return {\"alpha_EW\": alpha_EW, \"gZ_EW\": gZ_EW, \"lam_EW\": lam_EW, \"yE_EW\": yE_EW,\n","            \"m_pred\": yE_EW*v_phi/math.sqrt(2.0), \"names\": names, \"mus\": np.exp(t_grid), \"dense\": states}\n","\n","# ---------- Calibration ----------\n","def match_gZ_from_gNA(gNA, omega=OMEGA_PROJ, deltaZ=DELTA_Z_FIN):\n","    return 1/math.sqrt(max(omega/gNA**2 + deltaZ, 1e-12))\n","\n","def tune_gZ_to_alpha(target_inv, gNA_seed, lam_Lq, yLq_vec, sp, Qp):\n","    gZ_sat,alpha_sat = ir_floor_estimate(sp,Qp)\n","    if target_inv < (1/alpha_sat): raise RuntimeError(f\"α^-1 target {target_inv:.2f} unreachable.\")\n","    def obj(gz):\n","        try: return 1/run_once_multi(gz,lam_Lq,yLq_vec,sp,Qp)['alpha_EW'] - target_inv\n","        except RuntimeError: return float('nan')\n","    gZ_match = match_gZ_from_gNA(gNA_seed)\n","    lo, hi = max(0.8*gZ_sat, 0.5*gZ_match), min(0.9*BLOWUP_CUTOFF, 2*gZ_match)\n","    try: return brentq(obj, lo, hi, xtol=1e-9, rtol=1e-7, maxiter=100)\n","    except (ValueError, RuntimeError): return gZ_match\n","\n","def calibrate_Xi_from_ref(ref_nm, ref_m, gZ_Lq, lam_Lq, sp, Qp, r_w):\n","    names = [s.name for s in sp if s.active]; idx = names.index(ref_nm)\n","    y_ref_EW = math.sqrt(2)*ref_m/v_phi\n","    xi_guess = y_ref_EW/max(r_w.get(ref_nm,1),1e-12)\n","    def obj(xi):\n","        y_vec = np.array([max(1e-12, xi*r_w.get(n,1)) for n in names])\n","        try: return run_once_multi(gZ_Lq,lam_Lq,y_vec,sp,Qp)['m_pred'][idx] - ref_m\n","        except RuntimeError: return 1e6\n","    lo, hi = xi_guess/100, xi_guess*10\n","    try: return brentq(obj, lo, hi, xtol=1e-12, rtol=1e-9, maxiter=200)\n","    except (ValueError, RuntimeError): return xi_guess\n","\n","def qf_for_alpha_floor_eq_target(target_inv, roster=DIRAC_ROSTER, Qp=Q_PHI, gL=gL_muEW, mu=MU_EW, Lq=LAMBDA_Q):\n","    S2F0 = sum(r[1]*(r[2]**2+r[3]**2) for r in roster if r[4])\n","    K = math.log(Lq/mu)/(2*math.pi)\n","    num = target_inv - (4*math.pi/gL**2 + K*Qp**2/3)\n","    den = K*4/3*S2F0\n","    if num<=0 or den<=0: raise RuntimeError(\"Target α^-1 unreachable.\")\n","    return math.sqrt(num/den)\n","\n","# ---------- Geometric mass map (Axis Model) ----------\n","from math import sqrt, exp\n","\n","# Default best-fit geometric parameters (keep or fit; see note below)\n","GEOM_DEFAULTS = dict(\n","    alpha_stress = 50.001383,\n","    beta2        = 1.186016,\n","    beta3        = 0.710383,\n","    gamma1_0     = 0.105148,\n","    gamma3_0     = 0.383574,\n",")\n","\n","# Species -> (sector, generation n, ℓ, vz)   (vz only matters for quarks)\n","# n: 1(e,u,d), 2(μ,c,s), 3(τ,t,b); ℓ: 0,1,2 as in the paper.\n","SPEC_GEOM = {\n","    \"e\":  (\"lep\",1,0,0), \"mu\": (\"lep\",2,1,0), \"tau\":(\"lep\",3,2,0),\n","    \"nu_e\":(\"nu\",1,0,0), \"nu_mu\":(\"nu\",2,1,0), \"nu_tau\":(\"nu\",3,2,0),\n","    \"u\":  (\"uq\",1,0,6),  \"c\":  (\"uq\",2,1,6),   \"t\":  (\"uq\",3,2,6),\n","    \"d\":  (\"dq\",1,0,9),  \"s\":  (\"dq\",2,1,9),   \"b\":  (\"dq\",3,2,9),\n","}\n","\n","def _vev_factor(n, beta2, beta3):\n","    # <Φ_n> hierarchy for 3 generations\n","    if n == 1:   return sqrt(1) * 1.0\n","    if n == 2:   return sqrt(3) * exp(-beta2)\n","    if n == 3:   return sqrt(5) * exp(-2.0*beta3)\n","    raise ValueError(\"n must be 1,2,3\")\n","\n","def _ftop(n, alpha_stress):\n","    # topological strain by generation\n","    if n == 1:   return 1.0\n","    if n == 2:   return 4.0 * (1.0 + alpha_stress)\n","    if n == 3:   return 9.0 * (1.0 + 4.0*alpha_stress)\n","    raise ValueError(\"n must be 1,2,3\")\n","\n","def _fcurv(ell, gamma1_0, gamma3_0):\n","    # curvature coupling on S^2 (no m-dependence here)\n","    s = sqrt(ell*(ell+1.0)) if ell>0 else 0.0\n","    L = ell*(ell+1.0)\n","    return 1.0 + gamma1_0*s + gamma3_0*L\n","\n","def _Nmorton(_name):\n","    # mass-level morton multiplier; use 3 for canonical 3-morton fermions\n","    return 3.0\n","\n","def _quark_dress(vz):\n","    # quark dressing ~ sqrt(vz/3) : up-type (vz=6)->√2, down-type (vz=9)->√3\n","    return sqrt(vz/3.0) if vz>0 else 1.0\n","\n","def geometric_weight_for_species(name, params=None):\n","    \"\"\"\n","    Dimensionless geometric mass weight G(name) before global Xi normalization.\n","    \"\"\"\n","    if params is None: params = GEOM_DEFAULTS\n","    alpha_stress=params[\"alpha_stress\"]; beta2=params[\"beta2\"]; beta3=params[\"beta3\"]\n","    gamma1_0=params[\"gamma1_0\"]; gamma3_0=params[\"gamma3_0\"]\n","\n","    sector, n, ell, vz = SPEC_GEOM.get(name, (\"lep\",1,0,0))\n","\n","    # neutrinos: tiny baseline (you can later swap in your dedicated neutrino module)\n","    if sector == \"nu\":\n","        base = 1e-6\n","        return base * (1.0 if n==1 else exp(-0.5*(n-1)))\n","\n","    vev  = _vev_factor(n, beta2, beta3)\n","    ftop = _ftop(n, alpha_stress)\n","    fcv  = _fcurv(ell, gamma1_0, gamma3_0)\n","    nm   = _Nmorton(name)\n","\n","    geo = nm * vev * ftop * fcv\n","    if sector in (\"uq\",\"dq\"):\n","        geo *= _quark_dress(vz)\n","\n","    return max(geo, 1e-12)\n","\n","def build_uv_weights_geometric(species, ref=REF_SPECIES, params=None, auto_quark_rebalance=True):\n","    \"\"\"\n","    Build UV_WEIGHTS using the geometric formula; normalize to ref so weight[ref]=1.\n","    Optionally apply an automatic quark-vs-lepton sector rebalance so that\n","    m_e predicted after anchoring 'ref' (usually 't') is correct.\n","\n","    The rebalance multiplies ALL quark weights by K_quark, where\n","        K_quark = (w_e / w_ref) * (m_ref / m_e)\n","    so that m_e = m_ref * (w_e / (K_quark * w_ref)) = observed m_e.\n","    This leaves quark masses unchanged when ref is a quark anchored by Xi.\n","    \"\"\"\n","    if params is None:\n","        params = GEOM_DEFAULTS\n","\n","    names = [s.name for s in species if s.active]\n","    Gw = {n: geometric_weight_for_species(n, params=params) for n in names}\n","\n","    # Optional: autobalance quark sector vs leptons using (ref, e) pair\n","    if auto_quark_rebalance and (\"e\" in Gw) and (ref in Gw) and (ref in MASSES_GEV) and (\"e\" in MASSES_GEV):\n","        w_ref = max(Gw[ref], 1e-18)\n","        w_e   = max(Gw[\"e\"],  1e-18)\n","        m_ref = float(MASSES_GEV[ref])\n","        m_e   = float(MASSES_GEV[\"e\"])\n","        K_quark = (w_e / w_ref) * (m_ref / m_e)\n","        # apply to all quarks only\n","        for n in names:\n","            sector = SPEC_GEOM.get(n, (\"lep\",1,0,0))[0]\n","            if sector in (\"uq\",\"dq\"):\n","                Gw[n] *= K_quark\n","\n","    # Normalize to ref so that weight[ref] = 1.0, keeping your Xi calibration unchanged\n","    ref_w = max(Gw.get(ref, 1.0), 1e-18)\n","    return {n: Gw[n]/ref_w for n in names}\n","\n","    # --- Neutrino micro-correction (display normalization only) ---\n","    NU_DISPLAY_TARGET = float(MASSES_GEV.get(\"nu_e\", 1e-12))  # keep using your MASSES_GEV[\"nu_e\"]\n","\n","    probe2 = run_once_multi(gZ_Lq, lam_Lq, yLq, species, Qphi)\n","    try:\n","        i_nu = names.index(\"nu_e\")\n","        nu_pred = float(probe2[\"m_pred\"][i_nu])\n","        K_nu = max(1e-12, NU_DISPLAY_TARGET / max(1e-30, nu_pred))\n","    except ValueError:\n","        K_nu = 1.0\n","\n","    if abs(K_nu - 1.0) > 1e-6:\n","        yLq_corr2 = yLq.copy()\n","        for j, nm in enumerate(names):\n","            sector = SPEC_GEOM.get(nm, (\"lep\",1,0,0))[0]\n","            if sector == \"nu\":\n","                yLq_corr2[j] *= K_nu\n","        yLq = yLq_corr2\n","        print(f\"[geom] Applied neutrino normalization K_nu={K_nu:.6e} to hit {NU_DISPLAY_TARGET:g} GeV\")\n","\n","# ---------- Pipeline ----------\n","def run_pipeline(mode=MODE, roster=DIRAC_ROSTER, Qphi=Q_PHI, lam_Lq=lam_Lq_seed,\n","                 gNA_plus=gNA_Lq_plus, r_w=UV_WEIGHTS, ref_nm=REF_SPECIES, ref_m=TARGET_MASS):\n","    global QF_SCALE\n","    if auto_qf_scale:\n","        try:\n","            QF_SCALE = qf_for_alpha_floor_eq_target(alphaEW_inv_target, roster, Qphi, gL_muEW, MU_EW, LAMBDA_Q)\n","            print(f\"[diagnostic] Auto-set QF_SCALE={QF_SCALE:.6f} for α_floor^-1 ≈ {alphaEW_inv_target}\")\n","        except RuntimeError as e: print(f\"[warning] QF auto-scale failed: {e}. Using default.\")\n","        species = roster_to_species(roster, QF_SCALE)\n","    if not r_w:\n","        # Use the Axis geometric mass map (default parameter set)\n","        geom_params = dict(GEOM_DEFAULTS)  # or fit params later if desired\n","        r_w = build_uv_weights_geometric(species, ref=ref_nm, params=geom_params)\n","\n","\n","    gZ_sat, alpha_sat = ir_floor_estimate(species, Qphi)\n","    print(f\"[diagnostic] With QF_SCALE={QF_SCALE:.3f}: gZ^sat(MZ)≈{gZ_sat:.4f}, α_sat^-1≈{1/alpha_sat:.2f}\")\n","\n","    names = [s.name for s in species if s.active]\n","    if mode == \"calibrate_minimal\":\n","        print(\"[calibration] Beginning...\")\n","        gZ_Lq_prov = match_gZ_from_gNA(gNA_plus)\n","        Xi_prov = calibrate_Xi_from_ref(ref_nm, ref_m, gZ_Lq_prov, lam_Lq, species, Qphi, r_w)\n","        yLq_prov = np.array([Xi_prov * r_w.get(n, 1.0) for n in names])\n","        gZ_Lq = tune_gZ_to_alpha(alphaEW_inv_target, gNA_plus, lam_Lq, yLq_prov, species, Qphi)\n","        Xi = calibrate_Xi_from_ref(ref_nm, ref_m, gZ_Lq, lam_Lq, species, Qphi, r_w)\n","        yLq = np.array([Xi * r_w.get(n, 1.0) for n in names])\n","\n","        # --- One-shot EW lepton sector correction (handles running tilt) ---\n","        # Probe run to measure m_e error at μ_EW:\n","        probe = run_once_multi(gZ_Lq, lam_Lq, yLq, species, Qphi)\n","        try:\n","            i_e = names.index(\"e\")\n","            me_pred = float(probe[\"m_pred\"][i_e])\n","            me_exp  = float(MASSES_GEV[\"e\"])\n","            K_lep   = max(1e-12, me_exp / max(1e-18, me_pred))\n","        except ValueError:\n","            K_lep = 1.0  # no 'e' present (unlikely), skip\n","\n","        if abs(K_lep - 1.0) > 1e-6:\n","            # Rescale UV Yukawas for leptons (incl. neutrinos) by the same factor\n","            yLq_corr = yLq.copy()\n","            for j, nm in enumerate(names):\n","                sector = SPEC_GEOM.get(nm, (\"lep\",1,0,0))[0]\n","                if sector in (\"lep\", \"nu\"):\n","                    yLq_corr[j] *= K_lep\n","            yLq = yLq_corr\n","\n","        print(\"[calibration] Complete.\")\n","\n","    else: # predict_only\n","        gZ_Lq = match_gZ_from_gNA(gNA_plus)\n","        Xi=Xi_global\n","        yLq = np.array([Xi * r_w.get(n, 1.0) for n in names])\n","\n","    out = run_once_multi(gZ_Lq, lam_Lq, yLq, species, Qphi)\n","\n","    alphaMZ_inv = 1.0 / out['alpha_EW']\n","\n","    # External inputs at MZ (edit to your preferred values if needed)\n","    DA_lep  = 0.0314977     # leptonic\n","    DA_had5 = 0.02764       # hadronic (5 flavors): external, dispersive\n","    DA_top  = -0.00007      # top (tiny)\n","    DA_tot  = DA_lep + DA_had5 + DA_top\n","\n","    # Mapping: α^{-1}(0) = α^{-1}(MZ) / (1 - Δα)\n","    alpha0_inv = alphaMZ_inv / (1.0 - DA_tot)\n","\n","    # --- External (hadronic VP) band ---\n","    sigma_had = 0.00007\n","    d_alpha0_d_DAhad = alphaMZ_inv / (1.0 - DA_tot)**2\n","    delta_alpha0_ext = d_alpha0_d_DAhad * sigma_had\n","\n","    print(\"\\n\" + \"=\"*25 + \"\\n      FINAL RESULTS\\n\" + \"=\"*25)\n","    print(f\"\\n--- Seeds at Λ_q^- ---\\ngZ(Λ_q^-) = {gZ_Lq:.6f}    λ(Λ_q^-) = {lam_Lq:.6f}\")\n","    if mode == 'calibrate_minimal': print(f\"Calibrated Xi_global = {Xi:.6e}\")\n","    print(f\"\\n--- Values at μ_EW ---\\ngZ(μ_EW) = {out['gZ_EW']:.6f}    λ(μ_EW) = {out['lam_EW']:.6f}\")\n","    print(f\"α(μ_EW)^-1 = {1/out['alpha_EW']:.4f}\\nα(0)^-1     = {alpha0_inv:.4f}\")\n","\n","    delta_alpha0_int = 0.0  # Scenario A: α(MZ) normalized to EW fit; internal band at MZ is not assigned\n","    print(f\"[audit] α(MZ)^-1 = {alphaMZ_inv:.6f}\")\n","    print(f\"[audit] α(0)^-1  = {alpha0_inv:.6f}\")\n","    print(f\"[audit] internal band = ±{delta_alpha0_int:.6f}\")\n","    print(f\"[audit] external band = ±{delta_alpha0_ext:.6f}  (from Δα_had^(5))\")\n","\n","    print(\"\\n--- Mass predictions ---\")\n","\n","    # Choose comparison map (MZ vs low-scale PDG)\n","    comp_map = MZ_MASSES_GEV if COMPARE_AT_MZ else MASSES_GEV\n","    exp_vals = [comp_map.get(n) for n in names]\n","\n","    pred_df = pd.DataFrame({\n","        'Species': names,\n","        'Predicted Mass (GeV)': out['m_pred'],\n","        'Reference Mass (GeV)': exp_vals,\n","    })\n","\n","    pred_df['Rel Error (%)'] = 100 * (pred_df['Predicted Mass (GeV)'] / pred_df['Reference Mass (GeV)'] - 1)\n","\n","    print(pred_df.to_string(index=False, float_format=\"%.4e\"))\n","    pred_df.to_csv(f\"{OUT_DIR}/mass_predictions.csv\", index=False)\n","\n","    if save_plots:\n","        mus, grid = out['mus'], out['dense']\n","        gZ_flow   = grid[0]\n","        lam_flow  = grid[1]\n","        # Select top Yukawa curve if present\n","        y_idx = names.index('t') if 't' in names else 0\n","        yt_flow  = grid[2 + y_idx]\n","\n","        # Reference scales\n","        mu_lo = MU_EW\n","        mu_hi = LAMBDA_Q\n","\n","        fig, axs = plt.subplots(1, 3, figsize=(15, 4))\n","        for ax in axs:\n","            ax.grid(True, which='both', alpha=0.25)\n","            ax.set_xscale('log')\n","            ax.margins(x=0.02, y=0.08)\n","\n","        # gZ(μ)\n","        axs[0].plot(mus, gZ_flow, lw=1.8)\n","        axs[0].set(title=r'$g_Z(\\mu)$ Flow', xlabel=r'$\\mu$ [GeV]')\n","        axs[0].axvline(mu_lo, ls='--', alpha=0.5)\n","        axs[0].axvline(mu_hi, ls='--', alpha=0.5)\n","\n","        # λ(μ)\n","        axs[1].plot(mus, lam_flow, lw=1.8)\n","        axs[1].axhline(0, ls='--', alpha=0.5)  # vacuum bound\n","        axs[1].set(title=r'$\\lambda(\\mu)$ Flow', xlabel=r'$\\mu$ [GeV]')\n","        axs[1].axvline(mu_lo, ls='--', alpha=0.5)\n","        axs[1].axvline(mu_hi, ls='--', alpha=0.5)\n","\n","        # y_t(μ)\n","        axs[2].plot(mus, yt_flow, lw=1.8)\n","        axs[2].set(title=r'$y_t(\\mu)$ Flow', xlabel=r'$\\mu$ [GeV]')\n","        axs[2].axvline(mu_lo, ls='--', alpha=0.5)\n","        axs[2].axvline(mu_hi, ls='--', alpha=0.5)\n","\n","        # --- Annotate values at μ ≈ MZ (pick the nearest point) ---\n","        i_EW = int(np.argmin(np.abs(mus - MU_EW)))\n","        gZ_MZ  = float(gZ_flow[i_EW])\n","        lam_MZ = float(lam_flow[i_EW])\n","        yt_MZ  = float(yt_flow[i_EW])\n","\n","        # a light textbox style\n","        tb = dict(boxstyle=\"round,pad=0.25\", facecolor=\"white\", alpha=0.6, lw=0.0)\n","\n","        # --- Uniform labels in bottom-left corner of each subplot ---\n","        tb = dict(boxstyle=\"round,pad=0.25\", facecolor=\"white\", alpha=0.6, lw=0.0)\n","\n","        axs[0].text(0.05, 0.10, fr'$g_Z(M_Z)={gZ_MZ:.3f}$',\n","                    transform=axs[0].transAxes, ha='left', va='bottom',\n","                    fontsize=9, bbox=tb)\n","\n","        axs[1].text(0.05, 0.10, fr'$\\lambda(M_Z)={lam_MZ:.3f}$',\n","                    transform=axs[1].transAxes, ha='left', va='bottom',\n","                    fontsize=9, bbox=tb)\n","\n","        axs[2].text(0.05, 0.10, fr'$y_t(M_Z)={yt_MZ:.3f}$',\n","                    transform=axs[2].transAxes, ha='left', va='bottom',\n","                    fontsize=9, bbox=tb)\n","\n","        plt.tight_layout()\n","        plt.savefig(f\"{OUT_DIR}/rge_flows.png\", dpi=300, bbox_inches='tight')\n","        plt.savefig(f\"{OUT_DIR}/rge_flows.pdf\", bbox_inches='tight', transparent=True)\n","\n","if __name__ == \"__main__\":\n","    run_pipeline()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"e71rclyhxAvm","outputId":"46e1f0e3-ec87-41c5-874a-0b6ddeb84eea","executionInfo":{"status":"ok","timestamp":1759748583031,"user_tz":240,"elapsed":15761,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["[diagnostic] Auto-set QF_SCALE=1.407915 for α_floor^-1 ≈ 127.95\n","[diagnostic] With QF_SCALE=1.408: gZ^sat(MZ)≈0.3572, α_sat^-1≈127.95\n","[calibration] Beginning...\n","[calibration] Complete.\n","\n","=========================\n","      FINAL RESULTS\n","=========================\n","\n","--- Seeds at Λ_q^- ---\n","gZ(Λ_q^-) = 3.000000    λ(Λ_q^-) = 0.800000\n","Calibrated Xi_global = 9.922814e-01\n","\n","--- Values at μ_EW ---\n","gZ(μ_EW) = 0.353889    λ(μ_EW) = 0.915606\n","α(μ_EW)^-1 = 129.8194\n","α(0)^-1     = 137.9690\n","[audit] α(MZ)^-1 = 129.819445\n","[audit] α(0)^-1  = 137.968953\n","[audit] internal band = ±0.000000\n","[audit] external band = ±0.010264  (from Δα_had^(5))\n","\n","--- Mass predictions ---\n","Species  Predicted Mass (GeV)  Reference Mass (GeV)  Rel Error (%)\n","      e            5.1100e-04            5.1100e-04     1.7473e-04\n","     mu            1.0566e-01            1.0566e-01     1.4243e-04\n","    tau            1.7768e+00            1.7769e+00    -1.6837e-03\n","   nu_e            1.0759e-10            1.0000e-12     1.0659e+04\n","  nu_mu            6.5254e-11            1.0000e-12     6.4254e+03\n"," nu_tau            3.9578e-11            1.0000e-12     3.8578e+03\n","      u            5.2717e-02            1.3800e-03     3.7201e+03\n","      d            5.5397e-02            2.8200e-03     1.8644e+03\n","      s            1.1454e+01            5.7000e-02     1.9995e+04\n","      c            1.0900e+01            6.2000e-01     1.6581e+03\n","      b            1.9263e+02            2.8200e+00     6.7308e+03\n","      t            1.8331e+02            1.7280e+02     6.0825e+00\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x400 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]}]}