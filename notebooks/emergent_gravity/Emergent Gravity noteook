{"cells":[{"cell_type":"code","source":["# Axis Model — Notebook 1: Seeley–DeWitt a1 coefficients (κ_s) and s(x)\n","# ---------------------------------------------------------------------------------\n","# Purpose\n","# -------\n","# Minimal, reusable primitives for species-level κ_s, the weighted sum Σ_s w_s κ_s,\n","# and the *matched* master-identity formula for the local coupling ratio\n","#     s(x) ≡ G_eff(x) / G_0 = 1 / [ 1 + (G0 * Λ_Φ^2 / (2π)) * (f(x) − 1) * Σ_s w_s κ_s ]\n","# derived from Eq. (30) + Eq. (32) in the Axis \"Emergent Gravity\" paper.\n","#\n","# Conventions (4D, proper-time regularization for curvature-linear term):\n","#  - Real scalar (nonminimal ξ): κ_scalar(ξ) = 1/6 − ξ\n","#  - Massless U(1) (vector + complex FP ghost, NET): κ = −2/3\n","#  - Massive U(1) (vector + Stückelberg + complex FP ghost, NET): κ = −1/2\n","#  - w_s includes statistics (+1 boson, −1 fermion) and multiplicity\n","#\n","# Usage\n","# -----\n","#  - Edit `baseline_content()` to reflect the field content you wish to sum.\n","#  - Use `s_from_master_identity(LambdaPhi, fphi, sum_wkappa_value, G0)`\n","#    to compute s(x) symbolically or numerically.\n","#\n","# ---------------------------------------------------------------------------------\n","\n","from dataclasses import dataclass\n","from typing import Optional, Literal, Union, List\n","\n","import sympy as sp\n","import pandas as pd\n","\n","# =============================================================================\n","# κ_s primitives (NET labels for vectors to avoid double counting)\n","# =============================================================================\n","\n","def kappa_scalar(xi: Union[float, sp.Symbol]) -> Union[float, sp.Expr]:\n","    \"\"\"κ_s for a *real* scalar with nonminimal coupling ξ: κ = 1/6 − ξ.\"\"\"\n","    xi_sym = sp.sympify(xi)\n","    return sp.Rational(1, 6) - xi_sym\n","\n","def kappa_vector_massless_NET() -> sp.Rational:\n","    \"\"\"NET κ_s for a massless U(1) (vector + complex FP ghost): κ_net = −2/3.\"\"\"\n","    return -sp.Rational(2, 3)\n","\n","def kappa_vector_massive_NET() -> sp.Rational:\n","    \"\"\"NET κ_s for a massive U(1) (vector + Stückelberg + complex FP ghost): κ_net = −1/2.\"\"\"\n","    return -sp.Rational(1, 2)\n","\n","# =============================================================================\n","# weights and species container\n","# =============================================================================\n","\n","def weight_boson(multiplicity: int = 1) -> int:\n","    \"\"\"Statistics/multiplicity weight for bosons.\"\"\"\n","    return +1 * int(multiplicity)\n","\n","def weight_fermion(multiplicity: int = 1) -> int:\n","    \"\"\"Statistics/multiplicity weight for fermions.\"\"\"\n","    return -1 * int(multiplicity)\n","\n","@dataclass\n","class Species:\n","    name: str\n","    kind: Literal[\"scalar\", \"vector_massless_NET\", \"vector_massive_NET\"]\n","    multiplicity: int = 1                 # use multiplicity=2 for a *complex* scalar\n","    xi: Optional[Union[float, sp.Symbol]] = None  # required for scalars\n","    boson: bool = True\n","\n","    def w(self) -> int:\n","        return weight_boson(self.multiplicity) if self.boson else weight_fermion(self.multiplicity)\n","\n","    def kappa(self) -> Union[float, sp.Expr]:\n","        if self.kind == \"scalar\":\n","            if self.xi is None:\n","                raise ValueError(\"Scalar species requires a 'xi' value.\")\n","            return kappa_scalar(self.xi)\n","        if self.kind == \"vector_massless_NET\":\n","            return kappa_vector_massless_NET()\n","        if self.kind == \"vector_massive_NET\":\n","            return kappa_vector_massive_NET()\n","        raise ValueError(f\"Unknown kind: {self.kind}\")\n","\n","    def wkappa(self) -> Union[float, sp.Expr]:\n","        return sp.simplify(self.w() * self.kappa())\n","\n","# =============================================================================\n","# helpers\n","# =============================================================================\n","\n","def sum_wkappa(species_list: List[Species]) -> Union[float, sp.Expr]:\n","    \"\"\"Compute Σ_s w_s κ_s over a list of Species.\"\"\"\n","    return sp.simplify(sum(s.wkappa() for s in species_list))\n","\n","def induced_EH_prefactor(Lambda: Union[float, sp.Symbol],\n","                         fphi: Union[float, sp.Symbol],\n","                         sum_wkappa_value: Union[float, sp.Expr]) -> Union[float, sp.Expr]:\n","    \"\"\"\n","    One-loop curvature-linear EH prefactor (proper-time scheme):\n","        C_R(x) = (1/2) * (Λ^2 / (4π)^2) * f(Φ(x)) * Σ_s w_s κ_s\n","    (Pre-matching, shown for completeness.)\n","    \"\"\"\n","    Λ = sp.sympify(Lambda)\n","    f = sp.sympify(fphi)\n","    return sp.simplify(sp.Rational(1, 2) * (Λ**2 / (4*sp.pi)**2) * f * sp.sympify(sum_wkappa_value))\n","\n","# =============================================================================\n","# Master-Identity-based s(x) (matched scheme, Eq. 30 + Eq. 32)\n","# =============================================================================\n","\n","def s_from_master_identity(LambdaPhi, fphi, sum_wkappa_value, G0):\n","    \"\"\"\n","    Master Identity + matching at a coherent reference (f≈1):\n","      s(x) = G_eff/G0 = 1 / [ 1 + (G0 * Λ_Φ^2 / (2π)) * (f(x) − 1) * Σ w κ ].\n","    \"\"\"\n","    Λ = sp.sympify(LambdaPhi)\n","    f = sp.sympify(fphi)\n","    S = sp.sympify(sum_wkappa_value)\n","    A = sp.sympify(G0) * Λ**2 / (2*sp.pi)\n","    return sp.simplify( 1 / ( 1 + A * (f - 1) * S ) )\n","\n","# =============================================================================\n","# Baseline content for the paper(complex scalar + U(1)_X + U(1)_Z (Stückelberg), all NET)\n","# =============================================================================\n","\n","def baseline_content(xi_symbol: sp.Symbol) -> List[Species]:\n","    return [\n","        Species(name=\"Φ (complex scalar)\",       kind=\"scalar\",               xi=xi_symbol, multiplicity=2, boson=True),\n","        Species(name=\"X_μ (massless U(1), NET)\", kind=\"vector_massless_NET\",  multiplicity=1, boson=True),\n","        Species(name=\"Z_μ (massive U(1), NET)\",  kind=\"vector_massive_NET\",   multiplicity=1, boson=True),\n","    ]\n","\n","# =============================================================================\n","# Demonstration / self-tests\n","# =============================================================================\n","\n","if __name__ == \"__main__\":\n","    # sanity on κ functions\n","    assert kappa_scalar(sp.Rational(1,6)) == 0\n","    assert kappa_vector_massless_NET() == -sp.Rational(2,3)\n","    assert kappa_vector_massive_NET() == -sp.Rational(1,2)\n","\n","    # build baseline complex-scalar content\n","    xi = sp.symbols('xi', real=True)\n","    species = baseline_content(xi)\n","    WKAPPA = sum_wkappa(species)\n","\n","    # Target check: Σ w κ = -5/6 - 2 ξ\n","    assert sp.simplify(WKAPPA - (-sp.Rational(5,6) - 2*xi)) == 0\n","\n","    # Pretty print species table\n","    rows = []\n","    for s in species:\n","        rows.append({\n","            \"species\": s.name,\n","            \"kind\": s.kind,\n","            \"multiplicity\": s.multiplicity,\n","            \"xi\": s.xi if s.kind == \"scalar\" else \"\",\n","            \"kappa_s\": sp.simplify(s.kappa()),\n","            \"w_s\": s.w(),\n","            \"w_s*kappa_s\": sp.simplify(s.wkappa()),\n","        })\n","    df_species = pd.DataFrame(rows)\n","\n","    print(\"\\n=== Species summary (baseline paper content) ===\")\n","    print(df_species.to_string(index=False))\n","\n","    print(\"\\nΣ w_s κ_s (symbolic) =\", WKAPPA)\n","    print(\"  minimal scalar (ξ=0):    \", sp.simplify(WKAPPA.subs({xi: 0})))\n","    print(\"  conformal scalar (ξ=1/6):\", sp.simplify(WKAPPA.subs({xi: sp.Rational(1,6)})))\n","\n","    # Example: symbolic s(x)\n","    ΛΦ, f, G0 = sp.symbols('LambdaPhi f G0', positive=True, real=True)\n","    s_sym = s_from_master_identity(ΛΦ, f, WKAPPA, G0)\n","    print(\"\\ns(x) = 1 / [ 1 + (G0 Λ_Φ^2 / (2π)) (f-1) Σ wκ ] =\")\n","    print(s_sym)\n","\n","    # Sanity: at coherent reference (f=1), s=1\n","    s_at_ref = sp.simplify(s_sym.subs({f: 1}))\n","    print(\"\\ns(f=1) =\", s_at_ref)\n","    assert s_at_ref == 1\n","\n","    # Optional: show the loop prefactor (pre-matching), useful for diagnostics\n","    C_R = induced_EH_prefactor(ΛΦ, f, WKAPPA)\n","    print(\"\\nOne-loop EH prefactor C_R(x) = (1/2)*(Λ_Φ^2/(4π)^2)*f*Σ wκ =\")\n","    print(C_R)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5jU5sieevyFG","executionInfo":{"status":"ok","timestamp":1761301054565,"user_tz":240,"elapsed":9821,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"735a10b6-d54d-4105-d769-e13918e8b0db"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","=== Species summary (baseline paper content) ===\n","                 species                kind  multiplicity xi  kappa_s  w_s w_s*kappa_s\n","      Φ (complex scalar)              scalar             2 xi 1/6 - xi    2  1/3 - 2*xi\n","X_μ (massless U(1), NET) vector_massless_NET             1        -2/3    1        -2/3\n"," Z_μ (massive U(1), NET)  vector_massive_NET             1        -1/2    1        -1/2\n","\n","Σ w_s κ_s (symbolic) = -2*xi - 5/6\n","  minimal scalar (ξ=0):     -5/6\n","  conformal scalar (ξ=1/6): -7/6\n","\n","s(x) = 1 / [ 1 + (G0 Λ_Φ^2 / (2π)) (f-1) Σ wκ ] =\n","-12*pi/(G0*LambdaPhi**2*(f - 1)*(12*xi + 5) - 12*pi)\n","\n","s(f=1) = 1\n","\n","One-loop EH prefactor C_R(x) = (1/2)*(Λ_Φ^2/(4π)^2)*f*Σ wκ =\n","-LambdaPhi**2*f*(12*xi + 5)/(192*pi**2)\n"]}]},{"cell_type":"code","source":["# Notebook 2 — G_eff(x) maps via Master Identity + Matching\n","# ------------------------------------------------------------------------\n","# s(x) = G_eff/G0 from a coherence profile f(x), with exact reference/target control.\n","#\n","# Core identity (reference, target):\n","#   1/(16π G_eff(x)) = 1/(16π G0) + (Λ_Φ^2/(32π^2)) [ f(x) Σ_target − Σ_ref ]\n","# ⇒ s(x) = 1 / [ 1 + (G0 Λ_Φ^2 / (2π)) ( f(x) Σ_target − Σ_ref ) ].\n","# If reference == target: s(x) = 1 / [1 + β (f(x) − 1)], β ≡ (G0 Λ_Φ^2 / (2π)) Σ_target .\n","# ------------------------------------------------------------------------\n","\n","from dataclasses import dataclass\n","from typing import Optional, Literal, Union, List, Callable, Dict, Tuple\n","\n","import numpy as np\n","import sympy as sp\n","import matplotlib.pyplot as plt\n","import pandas as pd\n","\n","# =============================================================================\n","# κ_s primitives (NET labels for vectors to avoid double counting)\n","# =============================================================================\n","\n","def kappa_scalar(xi: Union[float, sp.Symbol]) -> Union[float, sp.Expr]:\n","    \"\"\"κ_s for a real scalar with nonminimal coupling ξ: κ = 1/6 − ξ.\"\"\"\n","    xi_sym = sp.sympify(xi)\n","    return sp.Rational(1, 6) - xi_sym\n","\n","def kappa_vector_massless_NET() -> sp.Rational:\n","    \"\"\"NET κ_s for a massless U(1) (vector + complex FP ghost): κ_net = −2/3.\"\"\"\n","    return -sp.Rational(2, 3)\n","\n","def kappa_vector_massive_NET() -> sp.Rational:\n","    \"\"\"NET κ_s for a massive U(1) (vector + Stückelberg + complex FP ghost): κ_net = −1/2.\"\"\"\n","    return -sp.Rational(1, 2)\n","\n","# =============================================================================\n","# weights and species container\n","# =============================================================================\n","\n","def weight_boson(multiplicity: int = 1) -> int:\n","    return +1 * int(multiplicity)\n","\n","def weight_fermion(multiplicity: int = 1) -> int:\n","    return -1 * int(multiplicity)\n","\n","@dataclass\n","class Species:\n","    name: str\n","    kind: Literal[\"scalar\", \"vector_massless_NET\", \"vector_massive_NET\"]\n","    multiplicity: int = 1                 # use multiplicity=2 for a complex scalar\n","    xi: Optional[Union[float, sp.Symbol]] = None\n","    boson: bool = True\n","\n","    def w(self) -> int:\n","        return weight_boson(self.multiplicity) if self.boson else weight_fermion(self.multiplicity)\n","\n","    def kappa(self) -> Union[float, sp.Expr]:\n","        if self.kind == \"scalar\":\n","            if self.xi is None:\n","                raise ValueError(\"Scalar species requires a 'xi' value.\")\n","            return kappa_scalar(self.xi)\n","        if self.kind == \"vector_massless_NET\":\n","            return kappa_vector_massless_NET()\n","        if self.kind == \"vector_massive_NET\":\n","            return kappa_vector_massive_NET()\n","        raise ValueError(f\"Unknown kind: {self.kind}\")\n","\n","    def wkappa(self) -> Union[float, sp.Expr]:\n","        return sp.simplify(self.w() * self.kappa())\n","\n","# =============================================================================\n","# helpers\n","# =============================================================================\n","\n","def sum_wkappa(species_list: List[Species]) -> Union[float, sp.Expr]:\n","    return sp.simplify(sum(s.wkappa() for s in species_list))\n","\n","def summarize_species(species_list: List[Species]) -> pd.DataFrame:\n","    rows = []\n","    for s in species_list:\n","        rows.append({\n","            \"species\": s.name,\n","            \"kind\": s.kind,\n","            \"multiplicity\": s.multiplicity,\n","            \"xi\": s.xi if s.kind == \"scalar\" else \"\",\n","            \"kappa_s\": sp.simplify(s.kappa()),\n","            \"w_s\": s.w(),\n","            \"w_s*kappa_s\": sp.simplify(s.wkappa()),\n","        })\n","    return pd.DataFrame(rows)\n","\n","def beta_to_LambdaPhi(beta: float, G0: float, S: float) -> float:\n","    \"\"\"Solve β = (G0 Λ_Φ^2 / (2π)) * |S|  => Λ_Φ = sqrt( 2π β / (G0 |S|) ).\"\"\"\n","    return float(np.sqrt((2.0*np.pi * float(beta)) / (float(G0) * abs(float(S)))))\n","\n","def s_from_master_identity_general(LambdaPhi: float,\n","                                   f_array: np.ndarray,\n","                                   S_target: float,\n","                                   S_ref: float,\n","                                   G0: float) -> np.ndarray:\n","    A = (G0 * (LambdaPhi**2)) / (2.0 * np.pi)\n","    denom = 1.0 + A * (f_array * S_target - S_ref)\n","    return 1.0 / denom\n","\n","def export_csv(path: str, x: np.ndarray, f: np.ndarray, s: np.ndarray) -> None:\n","    df = pd.DataFrame({\"x\": x, \"f\": f, \"s\": s})\n","    df.to_csv(path, index=False)\n","\n","def save_figure(fig: plt.Figure, path: str, dpi: int = 200) -> None:\n","    fig.savefig(path, dpi=dpi, bbox_inches=\"tight\")\n","\n","# =============================================================================\n","# Field-content builders\n","# =============================================================================\n","\n","def build_content_complex_scalar_u1s(xi: Union[float, sp.Symbol],\n","                                     include_scalar=True, include_X=True, include_Z=True,\n","                                     mult_scalar: int = 2, mult_X: int = 1, mult_Z: int = 1) -> List[Species]:\n","    out: List[Species] = []\n","    if include_scalar:\n","        out.append(Species(name=\"Φ (complex scalar)\", kind=\"scalar\", xi=xi, multiplicity=mult_scalar, boson=True))\n","    if include_X:\n","        out.append(Species(name=\"X_μ (massless U(1), NET)\", kind=\"vector_massless_NET\", multiplicity=mult_X, boson=True))\n","    if include_Z:\n","        out.append(Species(name=\"Z_μ (massive U(1), NET)\",  kind=\"vector_massive_NET\",  multiplicity=mult_Z, boson=True))\n","    return out\n","\n","# =============================================================================\n","# Main API\n","# =============================================================================\n","\n","def compute_Geff_maps(\n","    f_profile: Union[np.ndarray, Callable[[np.ndarray], np.ndarray]],\n","    x: Optional[np.ndarray] = None,\n","    *,\n","    # Either pass LambdaPhi directly, or pass beta and we'll compute LambdaPhi from (G0,S_target)\n","    LambdaPhi: Optional[float] = None,\n","    beta: Optional[float] = None,\n","    G0: float,\n","    # target content:\n","    include_scalar: bool = True,\n","    include_X: bool = True,\n","    include_Z: bool = True,\n","    xi: float = 0.0,\n","    mult_scalar: int = 2, mult_X: int = 1, mult_Z: int = 1,\n","    # reference content (defaults to target):\n","    include_scalar_ref: Optional[bool] = None,\n","    include_X_ref: Optional[bool] = None,\n","    include_Z_ref: Optional[bool] = None,\n","    xi_ref: Optional[float] = None,\n","    mult_scalar_ref: Optional[int] = None,\n","    mult_X_ref: Optional[int] = None,\n","    mult_Z_ref: Optional[int] = None,\n",") -> Dict[str, Union[np.ndarray, float, sp.Expr]]:\n","    # Prepare grid and f(x)\n","    if callable(f_profile):\n","        if x is None:\n","            raise ValueError(\"If f_profile is a function, provide an x grid.\")\n","        f = np.asarray(f_profile(x), dtype=float)\n","    else:\n","        f = np.asarray(f_profile, dtype=float)\n","        if x is None:\n","            x = np.arange(f.size)\n","    x = np.asarray(x, dtype=float)\n","\n","    # Build Σ for target/ref\n","    xi_sym = sp.symbols('xi', real=True)\n","    target_list = build_content_complex_scalar_u1s(xi_sym, include_scalar, include_X, include_Z,\n","                                                   mult_scalar=mult_scalar, mult_X=mult_X, mult_Z=mult_Z)\n","    S_target_expr = sum_wkappa(target_list)\n","    S_target = float(sp.N(S_target_expr.subs({xi_sym: xi})))\n","\n","    include_scalar_ref = include_scalar if include_scalar_ref is None else include_scalar_ref\n","    include_X_ref      = include_X      if include_X_ref      is None else include_X_ref\n","    include_Z_ref      = include_Z      if include_Z_ref      is None else include_Z_ref\n","    xi_ref             = xi             if xi_ref             is None else xi_ref\n","    mult_scalar_ref    = mult_scalar    if mult_scalar_ref    is None else mult_scalar_ref\n","    mult_X_ref         = mult_X         if mult_X_ref         is None else mult_X_ref\n","    mult_Z_ref         = mult_Z         if mult_Z_ref         is None else mult_Z_ref\n","\n","    ref_list = build_content_complex_scalar_u1s(xi_sym, include_scalar_ref, include_X_ref, include_Z_ref,\n","                                                mult_scalar=mult_scalar_ref, mult_X=mult_X_ref, mult_Z=mult_Z_ref)\n","    S_ref_expr = sum_wkappa(ref_list)\n","    S_ref = float(sp.N(S_ref_expr.subs({xi_sym: xi_ref})))\n","\n","    # Choose ΛΦ: either direct or via β\n","    if LambdaPhi is None and beta is None:\n","        raise ValueError(\"Provide either LambdaPhi or beta.\")\n","    if LambdaPhi is None and beta is not None:\n","        # if reference==target, β = (G0 Λ^2 /(2π)) S_target ; otherwise this is a nominal calibration\n","        LambdaPhi = beta_to_LambdaPhi(beta, G0, S_target)\n","\n","    # Compute s and G_eff\n","    s = s_from_master_identity_general(LambdaPhi, f, S_target, S_ref, G0)\n","    G_eff = s * G0\n","\n","    # Optional consistency assertion: if f reaches 1 and S_target==S_ref, then s should reach 1 (within tol)\n","    if abs(S_target - S_ref) < 1e-14:\n","        idx = int(np.nanargmax(f))\n","        if f[idx] > 0.999:\n","            assert abs(s[idx] - 1.0) < 1e-6, \"s(f≈1) should be ≈1 when target==reference.\"\n","\n","    # C_R via two methods (diagnostic)\n","    C_from_s  = 1.0 / (16.0 * np.pi * G_eff)\n","    C_from_id = (1.0 / (16.0 * np.pi * G0)) + (LambdaPhi**2) / (32.0 * (np.pi**2)) * (f * S_target - S_ref)\n","    max_abs_diff = float(np.nanmax(np.abs(C_from_s - C_from_id)))\n","\n","    return dict(x=x, f=f, s=s, G_eff=G_eff,\n","                S_target=S_target, S_ref=S_ref,\n","                S_target_expr=S_target_expr, S_ref_expr=S_ref_expr,\n","                LambdaPhi=float(LambdaPhi), beta=float(beta) if beta is not None else float((G0*(LambdaPhi**2)/(2*np.pi))*abs(S_target)),\n","                C_R_from_s=C_from_s, C_R_from_id=C_from_id, C_R_max_abs_diff=max_abs_diff)\n","\n","# =============================================================================\n","# Example usage (can comment out when importing as module)\n","# =============================================================================\n","if __name__ == \"__main__\":\n","    # Grid and profile\n","    x = np.linspace(-8, 8, 801)\n","    def f_gaussian(x, ell=1.0): return np.exp(-(x/ell)**2)\n","    f = f_gaussian\n","\n","    # Parameters\n","    G0 = 1.0\n","    xi = 0.0\n","\n","    # Choose β directly (paper-friendly), we’ll infer ΛΦ\n","    res = compute_Geff_maps(f_profile=f, x=x, beta=0.5, G0=G0, xi=xi,\n","                            include_scalar=True, include_X=True, include_Z=True,\n","                            mult_scalar=2, mult_X=1, mult_Z=1)\n","\n","    print(\"Σ_target (symbolic):\", res[\"S_target_expr\"])\n","    print(\"Σ_ref     (symbolic):\", res[\"S_ref_expr\"])\n","    print(\"Σ_target (numeric): \", res[\"S_target\"])\n","    print(\"Σ_ref    (numeric): \", res[\"S_ref\"])\n","    print(\"β used:\", res[\"beta\"], \" ⇒ ΛΦ inferred:\", res[\"LambdaPhi\"])\n","    print(\"C_R max |Δ|:\", res[\"C_R_max_abs_diff\"])\n","\n","    # Export CSV for Figure 1a\n","    export_csv(\"fig1a_data.csv\", res[\"x\"], res[\"f\"], res[\"s\"])\n","\n","    # Plot and save\n","    fig = plt.figure(figsize=(6.4, 3.8))\n","    plt.plot(res[\"x\"], res[\"s\"], label=\"s(x)\")\n","    plt.xlabel(\"x\")\n","    plt.ylabel(\"s(x) = G_eff/G0\")\n","    # plt.title(\"s(x) for Gaussian f(x), β=0.5\")\n","    plt.legend(loc=\"best\", frameon=False)\n","    plt.tight_layout()\n","    save_figure(fig, \"fig1a.png\")\n","    plt.close(fig)\n","\n","    print(\"Saved CSV -> fig1a_data.csv\")\n","    print(\"Saved PNG -> fig1a.png\")\n","\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yKqjKiYJ5Zhm","executionInfo":{"status":"ok","timestamp":1761301055255,"user_tz":240,"elapsed":685,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"a88c3883-6542-459f-a2b0-eec77ea812ed"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Σ_target (symbolic): -2*xi - 5/6\n","Σ_ref     (symbolic): -2*xi - 5/6\n","Σ_target (numeric):  -0.8333333333333334\n","Σ_ref    (numeric):  -0.8333333333333334\n","β used: 0.5  ⇒ ΛΦ inferred: 1.9416259125556992\n","C_R max |Δ|: 6.938893903907228e-18\n","Saved CSV -> fig1a_data.csv\n","Saved PNG -> fig1a.png\n"]}]},{"cell_type":"code","source":["# Notebook 3 — Observables from s = G_eff/G0\n","# ------------------------------------------------------------\n","# Single-factor closures in scalar-coherent, weak-field domains:\n","#   κ(θ)   = s(θ) * κ^(0)(θ)\n","#   γ(θ)   = s(θ) * γ^(0)(θ)\n","#   θ_E    = scale(s) * θ_E^(0)      [ scale(s)=√s for point-mass,  = s for SIS ]\n","#   Δt     = s_lens * Δt^(0)\n","#   h_GW   = s_LOS  * h_GW^(0)\n","#\n","# Mass models provided:\n","#   - 'point_mass' (Einstein angle ∝ √G)  -> θ_E ∝ √s\n","#   - 'SIS'        (Einstein angle ∝ G )  -> θ_E ∝ s\n","#\n","# s(θ) options:\n","#   (A) homogeneous: s(θ) = s0\n","#   (B) gradient   : smooth logistic ramp from s_min to s_max\n","#\n","# Plots use matplotlib defaults (one figure per chart).\n","# ------------------------------------------------------------\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# ---------- Units & constants ----------\n","arcsec_per_rad = 206265.0\n","rad_per_arcsec = 1.0 / arcsec_per_rad\n","\n","c = 299792458.0                 # m/s\n","G0_SI = 6.67430e-11             # SI\n","M_sun = 1.98847e30              # kg\n","Mpc   = 3.085677581491367e22    # m\n","\n","# ---------- GR baselines ----------\n","def theta_E_point_mass_GR(M_Msun, D_d_Mpc, D_s_Mpc, D_ds_Mpc, G0=G0_SI):\n","    \"\"\"Einstein angle (GR) for a point mass lens, radians.\"\"\"\n","    M = M_Msun * M_sun\n","    D_d  = D_d_Mpc  * Mpc\n","    D_s  = D_s_Mpc  * Mpc\n","    D_ds = D_ds_Mpc * Mpc\n","    theta_E2 = (4.0 * G0 * M / c**2) * (D_ds / (D_d * D_s))\n","    return np.sqrt(theta_E2)\n","\n","def theta_E_SIS_GR(sigma_v_kms, D_ds_Mpc, D_s_Mpc):\n","    \"\"\"Einstein angle (GR) for an SIS lens, radians.\"\"\"\n","    sigma = sigma_v_kms * 1e3  # m/s\n","    D_ds = D_ds_Mpc * Mpc\n","    D_s  = D_s_Mpc  * Mpc\n","    return 4.0 * np.pi * (sigma**2 / c**2) * (D_ds / D_s)\n","\n","def kappa_gamma_SIS_GR(theta_arcsec, theta_E_arcsec):\n","    \"\"\"GR baseline for SIS: κ0(θ)=γ0(θ)=θ_E/(2θ).\"\"\"\n","    th = np.asarray(theta_arcsec, dtype=float)\n","    th = np.maximum(th, 1e-12)\n","    k0 = theta_E_arcsec / (2.0 * th)\n","    return k0, k0\n","\n","def gamma_point_mass_GR(theta_arcsec, theta_E_arcsec):\n","    \"\"\"GR baseline shear for a point mass: γ0(θ)=θ_E^2/(2 θ^2). (κ0=0 away from center)\"\"\"\n","    th = np.asarray(theta_arcsec, dtype=float)\n","    th = np.maximum(th, 1e-12)\n","    return (theta_E_arcsec**2) / (2.0 * th**2)\n","\n","# ---------- Scaling closures ----------\n","def scale_theta_E(mass_model, s_scalar):\n","    \"\"\"Return multiplicative factor for θ_E given mass_model and scalar s.\"\"\"\n","    if mass_model == \"point_mass\":\n","        return np.sqrt(s_scalar)\n","    elif mass_model == \"SIS\":\n","        return s_scalar\n","    else:\n","        raise ValueError(\"mass_model must be 'point_mass' or 'SIS'\")\n","\n","def apply_s_to_lensing(kappa0, gamma0, s_theta):\n","    \"\"\"Apply s(θ) to κ0, γ0.\"\"\"\n","    return s_theta * kappa0, s_theta * gamma0\n","\n","def time_delay_point_mass_GR(M_Msun, beta_arcsec, D_d_Mpc, D_s_Mpc, D_ds_Mpc, z_d):\n","    \"\"\"\n","    GR time-delay difference between the two images of a point-mass lens:\n","      Δt0 = (4 G0 M / c^3) (1+z_d) * τ(y),  y = β/θ_E,\n","      τ(y) = 0.5 y sqrt(y^2+4) + ln( (sqrt(y^2+4)+y)/(sqrt(y^2+4)-y) ).\n","    \"\"\"\n","    thetaE = theta_E_point_mass_GR(M_Msun, D_d_Mpc, D_s_Mpc, D_ds_Mpc, G0_SI)  # radians\n","    beta   = beta_arcsec * rad_per_arcsec\n","    y = np.abs(beta / thetaE)\n","    tau = 0.5 * y * np.sqrt(y**2 + 4.0) + np.log((np.sqrt(y**2 + 4.0) + y) / (np.sqrt(y**2 + 4.0) - y))\n","    M = M_Msun * M_sun\n","    pref = (4.0 * G0_SI * M / c**3) * (1.0 + z_d)\n","    return pref * tau  # seconds\n","\n","def time_delay_scaled(Delta_t0_seconds, s_lens):\n","    \"\"\"Scaled time delay: Δt = s_lens * Δt0.\"\"\"\n","    return s_lens * Delta_t0_seconds\n","\n","def gw_amplitude_scaled(h0, s_los):\n","    \"\"\"GW strain scaling along the line of sight.\"\"\"\n","    return s_los * h0\n","\n","# ---------- s(θ) backgrounds ----------\n","def s_homogeneous(theta_arcsec, s0=1.0):\n","    \"\"\"Constant s over the field.\"\"\"\n","    return np.full_like(np.asarray(theta_arcsec, dtype=float), float(s0))\n","\n","def s_gradient(theta_arcsec, s_min=0.7, s_max=1.3, theta0_arcsec=5.0, width_arcsec=2.0):\n","    \"\"\"Smooth logistic gradient from s_min to s_max centered near theta0.\"\"\"\n","    th = np.asarray(theta_arcsec, dtype=float)\n","    return s_min + (s_max - s_min) / (1.0 + np.exp(-(th - theta0_arcsec)/width_arcsec))\n","\n","# ============================================================\n","# === Choose scenario (edit this block for the figure)     ===\n","# ============================================================\n","# Angular grid (arcsec)\n","theta = np.linspace(0.3, 30.0, 800)\n","\n","# Distances (illustrative)\n","D_d, D_s, D_ds = 1000.0, 2000.0, 1200.0  # Mpc\n","z_d = 0.3\n","\n","# Mass model: \"SIS\" or \"point_mass\"\n","mass_model = \"SIS\"        # <-- set the model you want for the figure\n","\n","# Homogeneous s across the field (use your chosen s0)\n","s0 = 0.90                  # e.g., s = 0.90 (weaker gravity)\n","s_theta = s_homogeneous(theta, s0=s0)\n","\n","# Point-mass lens params (used only if mass_model == \"point_mass\")\n","M_lens   = 1.0e12  # Msun\n","beta_src = 0.5     # arcsec (for time-delay demo)\n","\n","# SIS lens params (used only if mass_model == \"SIS\")\n","sigma_v = 220.0     # km/s\n","\n","# ============================================================\n","# === Build baselines, apply s(θ), compute observables     ===\n","# ============================================================\n","if mass_model == \"point_mass\":\n","    # Baseline θ_E (GR)\n","    thetaE0_rad    = theta_E_point_mass_GR(M_lens, D_d, D_s, D_ds, G0_SI)\n","    thetaE0_arcsec = thetaE0_rad * arcsec_per_rad\n","\n","    # Baseline γ0(θ) (κ0=0 away from center)\n","    gamma0 = gamma_point_mass_GR(theta, thetaE0_arcsec)\n","    kappa0 = np.zeros_like(theta)\n","\n","    # Apply s(θ)\n","    kappa, gamma = apply_s_to_lensing(kappa0, gamma0, s_theta)\n","\n","    # θ_E scaling (homogeneous s): √s\n","    thetaE_arcsec = scale_theta_E(\"point_mass\", s0) * thetaE0_arcsec\n","\n","    # Time delay\n","    Delta_t0 = time_delay_point_mass_GR(M_lens, beta_src, D_d, D_s, D_ds, z_d)\n","    Delta_t  = time_delay_scaled(Delta_t0, s0)\n","\n","elif mass_model == \"SIS\":\n","    # Baseline θ_E (GR)\n","    thetaE0_rad    = theta_E_SIS_GR(sigma_v, D_ds, D_s)\n","    thetaE0_arcsec = thetaE0_rad * arcsec_per_rad\n","\n","    # Baseline κ0, γ0\n","    kappa0, gamma0 = kappa_gamma_SIS_GR(theta, thetaE0_arcsec)\n","\n","    # Apply s(θ)\n","    kappa, gamma = apply_s_to_lensing(kappa0, gamma0, s_theta)\n","\n","    # θ_E scaling (homogeneous s): linear\n","    thetaE_arcsec = scale_theta_E(\"SIS\", s0) * thetaE0_arcsec\n","\n","    # Time-delay scaling (we show scaling only; use any GR baseline you prefer)\n","    Delta_t0 = 1.0e6  # seconds (illustrative)\n","    Delta_t  = time_delay_scaled(Delta_t0, s0)\n","\n","else:\n","    raise ValueError(\"mass_model must be 'point_mass' or 'SIS'\")\n","\n","# GW amplitude along LOS\n","h0 = 1.0\n","h  = gw_amplitude_scaled(h0, s0)\n","\n","# Add to the SIS branch, before plotting:\n","kappa0, gamma0 = kappa_gamma_SIS_GR(theta, thetaE0_arcsec)\n","kappa,  gamma  = apply_s_to_lensing(kappa0, gamma0, s_theta)\n","\n","# For the κ(θ) figure:\n","plt.figure()\n","plt.plot(theta, kappa0, label=r\"$\\kappa^{(0)}(\\theta)$ (GR)\")\n","plt.plot(theta, kappa,  label=rf\"$\\kappa(\\theta)=s\\,\\kappa^{(0)}(\\theta)$, $s={s0:.2f}$\")\n","plt.axvline(thetaE0_arcsec, linestyle=\"--\", linewidth=1.0, label=rf\"$\\theta_E^{{(0)}}={thetaE0_arcsec:.2f}$\")\n","plt.axvline(thetaE_arcsec,  linestyle=\":\",  linewidth=1.0, label=rf\"$\\theta_E=s\\,\\theta_E^{{(0)}}={thetaE_arcsec:.2f}$\")\n","plt.xlabel(r\"$\\theta$ [arcsec]\"); plt.ylabel(r\"$\\kappa(\\theta)$\")\n","# plt.title(r\"SIS: $\\kappa(\\theta)$ scaling\")\n","plt.legend(frameon=False);\n","plt.savefig(\"figure2_SIS.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# ============================================================\n","# === Plots (style kept minimal)                           ===\n","# ============================================================\n","\n","# 1) s(θ)\n","plt.figure()\n","plt.plot(theta, s_theta)\n","plt.xlabel(r\"$\\theta$ [arcsec]\")\n","plt.ylabel(r\"$s(\\theta)=G_{\\rm eff}/G_0$\")\n","plt.title(r\"$s(\\theta)$ (homogeneous)\")\n","plt.show()\n","\n","# 2) κ(θ)\n","plt.figure()\n","plt.plot(theta, kappa, label=r\"$\\kappa(\\theta)$\")\n","# Einstein-radius markers\n","plt.axvline(thetaE0_arcsec, linestyle=\"--\", linewidth=1.0, label=rf\"$\\theta_E^{{(0)}}={thetaE0_arcsec:.2f}$\")\n","label_scaled = r\"$\\theta_E=\\sqrt{s}\\,\\theta_E^{(0)}$\" if mass_model==\"point_mass\" else r\"$\\theta_E=s\\,\\theta_E^{(0)}$\"\n","plt.axvline(thetaE_arcsec, linestyle=\":\", linewidth=1.0, label=rf\"{label_scaled}={thetaE_arcsec:.2f}\")\n","plt.xlabel(r\"$\\theta$ [arcsec]\"); plt.ylabel(r\"$\\kappa(\\theta)$\")\n","plt.title(rf\"{mass_model.upper()}: $\\kappa(\\theta)=s\\,\\kappa^{{(0)}}(\\theta)$\")\n","plt.legend(loc=\"upper right\", frameon=False)\n","plt.show()\n","\n","# 3) γ(θ)\n","plt.figure()\n","plt.plot(theta, gamma)\n","plt.xlabel(r\"$\\theta$ [arcsec]\")\n","plt.ylabel(r\"$\\gamma(\\theta)$\")\n","plt.title(rf\"{mass_model.upper()}: $\\gamma(\\theta)=s\\,\\gamma^{{(0)}}(\\theta)$\")\n","plt.show()\n","\n","# 4) Print key numbers (for caption text)\n","print(f\"Model: {mass_model}\")\n","print(f\"s0: {s0:.3f}\")\n","print(f\"θ_E^(0): {thetaE0_arcsec:.3f} arcsec\")\n","print(f\"θ_E    : {thetaE_arcsec:.3f} arcsec  ({'√s' if mass_model=='point_mass' else 's'} scaling)\")\n","print(f\"Δt^(0): {Delta_t0:.3e} s\")\n","print(f\"Δt    : {Delta_t:.3e} s  (× s0)\")\n","print(f\"h_GW^(0): {h0:.3f},  h_GW: {h:.3f} (× s0)\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"g4DkeUb_VId8","executionInfo":{"status":"ok","timestamp":1761301058145,"user_tz":240,"elapsed":2881,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"333ffdfe-f088-4c8c-ae58-f596eb260f02"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Model: SIS\n","s0: 0.900\n","θ_E^(0): 0.838 arcsec\n","θ_E    : 0.754 arcsec  (s scaling)\n","Δt^(0): 1.000e+06 s\n","Δt    : 9.000e+05 s  (× s0)\n","h_GW^(0): 1.000,  h_GW: 0.900 (× s0)\n"]}]},{"cell_type":"code","source":["# This protocol freezes data objects, cuts, statistics, and decision rules for the three primary tests\n","# of the single-factor map: T1 (Einstein angle), T2 (time delays), T3 (standard sirens).\n","\n","\n","import os, json, hashlib, platform, sys\n","from pathlib import Path\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# ---- deterministic knobs ----\n","SEED = 20250301\n","np.random.seed(SEED)\n","\n","# ---- paths ----\n","ART_DIR = Path(\"artifacts\")\n","ART_DIR.mkdir(parents=True, exist_ok=True)   # <-- fix: ensure folder exists\n","\n","# ---- baselines + injection ----\n","thetaE0 = 1.20          # arcsec\n","Dt0     = 10.00         # days\n","h0      = 1.00e-21      # strain at f=100 Hz (fiducial)\n","s       = 0.95          # injection (editable)\n","\n","thetaE = np.sqrt(s) * thetaE0\n","Dt     = s * Dt0\n","h      = s * h0\n","\n","# --- Values table (rendered as a figure) ---\n","plt.figure(figsize=(4, 2.5))\n","plt.axis(\"off\")\n","plt.text(\n","    0.05, 0.60,\n","    f\"theta_E = {thetaE:.6f} arcsec\\n\"\n","    f\"Delta t = {Dt:.6f} days\\n\"\n","    f\"h(100 Hz) = {h:.3e}\",\n","    fontsize=11\n",")\n","f1_path = ART_DIR / \"F1_values.png\"\n","plt.savefig(f1_path, dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# --- Quadratic relation R_{Δt} vs R_θ^2 ---\n","Rtheta = thetaE/thetaE0\n","Rdt    = Dt/Dt0\n","plt.figure(figsize=(3.2, 3.2))\n","plt.scatter([Rtheta**2], [Rdt], label=\"injection\")\n","plt.plot([0.9, 1.1], [0.9, 1.1], linewidth=1.0, label=r\"$R_{\\Delta t}=R_\\theta^2$\")\n","plt.xlabel(r\"$R_\\theta^2$\"); plt.ylabel(r\"$R_{\\Delta t}$\")\n","plt.legend(frameon=False)\n","f2_path = ART_DIR / \"F2_quad.png\"\n","plt.savefig(f2_path, dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# --- Bars of s (T1/T2/T3) ---\n","plt.figure(figsize=(3.6, 3.0))\n","labs = [\"T1\", \"T2\", \"T3\"]\n","vals = [Rtheta**2, Rdt, h/h0]\n","plt.bar(labs, vals)\n","plt.axhline(1.0, linestyle=\"--\", linewidth=1.0)\n","plt.ylabel(\"s\")\n","f3_path = ART_DIR / \"F3_bars.png\"\n","plt.savefig(f3_path, dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# --- checksums + env capture (silent: writes files, no output) ---\n","def sha256(path: Path) -> str:\n","    with open(path, \"rb\") as fh:\n","        import hashlib\n","        return hashlib.sha256(fh.read()).hexdigest()\n","\n","checks = {\n","    f1_path.name: sha256(f1_path),\n","    f2_path.name: sha256(f2_path),\n","    f3_path.name: sha256(f3_path),\n","}\n","env = {\n","    \"python\": sys.version,\n","    \"platform\": platform.platform(),\n","    \"seed\": SEED,\n","    \"numpy\": np.__version__,\n","    \"matplotlib\": plt.matplotlib.__version__,\n","}\n","(ART_DIR / \"checksums.txt\").write_text(json.dumps(checks, indent=2))\n","(ART_DIR / \"env.txt\").write_text(json.dumps(env, indent=2))\n","# (no prints; figures already shown above)\n","\n","\n"],"metadata":{"id":"2EOlO-BWB3-2","executionInfo":{"status":"ok","timestamp":1761301114694,"user_tz":240,"elapsed":637,"user":{"displayName":"Andy Morton","userId":"16022260776226596890"}},"outputId":"fbf290b1-6e68-4d26-ef5b-8189098f2de2","colab":{"base_uri":"https://localhost:8080/","height":838}},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 400x250 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 320x320 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 360x300 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":["188"]},"metadata":{},"execution_count":5}]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNQ2l28jbfdYcdiHlsEqzbb"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}